---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
}

const {
  title = "Usagi Délice — Takoyaki d’Osaka à Paris",
  description = "Usagi Délice : takoyaki faits maison, préparés sur place, dans l’esprit de la street food d’Osaka à Paris.",
  canonical,
  ogImage = "/images/og.webp",
} = Astro.props as Props;

// ✅ safest canonical (no Astro.url typing dependency)
const canonicalUrl =
  canonical ??
  (typeof Astro !== "undefined" && (Astro as any).url
    ? new URL((Astro as any).url.pathname, "https://usagidelice.fr").toString()
    : "https://usagidelice.fr/");

const ogImageUrl = new URL(ogImage, "https://usagidelice.fr").toString();
const structuredData = {
  "@context": "https://schema.org",
  "@type": "FoodEstablishment",
  name: "Usagi Délice",
  url: "https://usagidelice.fr",
  image: ogImageUrl,
  description,
  servesCuisine: ["Japonaise", "Street food", "Takoyaki d’Osaka"],
  areaServed: ["Paris", "Île-de-France", "France"],
  email: "contact@usagidelice.fr",
  sameAs: ["https://www.instagram.com/usagidelice"],
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="canonical" href={canonicalUrl} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Usagi Délice" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={ogImageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="theme-color" content="#f6eadc" />
    <link rel="manifest" href="/site.webmanifest" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>

  <body>
    <Header logoSrc="/images/logo.png" brandName="Usagi Délice" />

    <main>
      <slot />
    </main>

    <Footer
      instagramUrl="https://www.instagram.com/usagidelice"
      email="usagideliceparis@gmail.com"
    />

    <!-- ✅ Scroll reveal (Apple-like): typed, astro-check safe -->
    <script>
      (() => {
        const prefersReduced =
          window.matchMedia &&
          window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        // ✅ typed elements so `.style` is valid
        const els = Array.from(
          document.querySelectorAll<HTMLElement>("[data-reveal]"),
        );

        if (prefersReduced) {
          els.forEach((el) => el.classList.add("is-in"));
          return;
        }

        for (const el of els) {
          const d = el.getAttribute("data-delay");
          if (d) el.style.setProperty("--reveal-delay", `${Number(d)}ms`);
        }

        // ✅ typed params to avoid implicit any
        const revealNow = (el: HTMLElement) => el.classList.add("is-in");

        const isInViewport = (el: HTMLElement) => {
          const r = el.getBoundingClientRect();
          const vh =
            window.innerHeight || document.documentElement.clientHeight;
          return r.top < vh * 0.75 && r.bottom > 0;
        };

        els.forEach((el) => {
          if (isInViewport(el)) revealNow(el);
        });

        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              // entry.target is Element → cast to HTMLElement for revealNow
              revealNow(entry.target as HTMLElement);
              io.unobserve(entry.target);
            }
          },
          { threshold: 0.12, rootMargin: "0px 0px -10% 0px" },
        );

        els.forEach((el) => {
          if (!el.classList.contains("is-in")) io.observe(el);
        });
      })();
    </script>

    <!-- ✅ Optional parallax (only affects elements with data-parallax attr) -->
    <script>
      (() => {
        const prefersReduced =
          window.matchMedia &&
          window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        if (prefersReduced) return;

        // ✅ typed elements so `.style` is valid
        const items = Array.from(
          document.querySelectorAll<HTMLElement>("[data-parallax]"),
        );
        if (!items.length) return;

        let ticking = false;

        const update = () => {
          ticking = false;

          const vh =
            window.innerHeight || document.documentElement.clientHeight;

          for (const el of items) {
            const type = el.getAttribute("data-parallax") || "media";
            const r = el.getBoundingClientRect();

            const center = r.top + r.height / 2;
            const p = (center - vh / 2) / (vh / 2);

            const range = type === "hero" ? 18 : type === "media" ? 14 : 10;
            const y = Math.max(-range, Math.min(range, -p * range));

            el.style.setProperty("--py", `${y}px`);
          }
        };

        const onScroll = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(update);
        };

        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll);

        update();
      })();
    </script>
    <!-- Global smart section snapping: short sections snap, long sections scroll freely until their edge -->
    <script data-global-smart-snap>
      (() => {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        const sections = Array.from(
          document.querySelectorAll<HTMLElement>("main > section, main > div > section"),
        ).filter((section) => !section.classList.contains("lb"));
        if (sections.length < 2) return;

        let snapping = false;
        let wheelAccumulator = 0;
        let resetTimer: ReturnType<typeof window.setTimeout> | undefined;

        const headerOffset = () => window.innerWidth <= 820 ? 70 : 82;
        const getScrollY = () =>
          document.body.scrollTop || document.documentElement.scrollTop || window.scrollY;
        const sectionTop = (section: HTMLElement) =>
          Math.max(0, getScrollY() + section.getBoundingClientRect().top - headerOffset());
        const sectionBottom = (section: HTMLElement) =>
          getScrollY() + section.getBoundingClientRect().bottom;
        const tops = () => sections.map(sectionTop);

        const setScrollY = (top: number) => {
          const options: ScrollToOptions = { top, behavior: "smooth" };
          document.body.scrollTo(options);
          document.documentElement.scrollTo(options);
          window.scrollTo(options);
        };

        const activeIndex = () => {
          const y = getScrollY() + headerOffset() + 2;
          let index = 0;
          for (let i = 0; i < sections.length; i += 1) {
            if (sectionTop(sections[i]) + headerOffset() <= y) index = i;
            else break;
          }
          return index;
        };

        const canScrollInside = (index: number, direction: number) => {
          const section = sections[index];
          const y = getScrollY();
          const top = sectionTop(section);
          const bottom = sectionBottom(section);
          const viewport = window.innerHeight;
          const usableViewport = viewport - headerOffset();
          const longSection = section.offsetHeight > usableViewport + 80;
          if (!longSection) return false;

          if (direction > 0) return y + viewport < bottom - 42;
          return y > top + 42;
        };

        const goTo = (index: number) => {
          const bounded = Math.max(0, Math.min(sections.length - 1, index));
          snapping = true;
          setScrollY(tops()[bounded]);
          window.setTimeout(() => {
            snapping = false;
            wheelAccumulator = 0;
          }, 760);
        };

        window.addEventListener("wheel", (event) => {
          if (Math.abs(event.deltaY) < 2) return;
          if (snapping) {
            event.preventDefault();
            return;
          }

          const direction = event.deltaY > 0 ? 1 : -1;
          const current = activeIndex();

          if (canScrollInside(current, direction)) {
            wheelAccumulator = 0;
            return;
          }

          wheelAccumulator += event.deltaY;
          if (resetTimer) window.clearTimeout(resetTimer);
          resetTimer = window.setTimeout(() => { wheelAccumulator = 0; }, 180);

          if (Math.abs(wheelAccumulator) < 18) return;
          event.preventDefault();
          goTo(current + direction);
        }, { passive: false });

        let touchStartY = 0;
        window.addEventListener("touchstart", (event) => {
          touchStartY = event.touches[0]?.clientY ?? 0;
        }, { passive: true });

        window.addEventListener("touchend", (event) => {
          if (snapping) return;
          const endY = event.changedTouches[0]?.clientY ?? touchStartY;
          const delta = touchStartY - endY;
          if (Math.abs(delta) < 34) return;
          const direction = delta > 0 ? 1 : -1;
          const current = activeIndex();
          if (canScrollInside(current, direction)) return;
          goTo(current + direction);
        }, { passive: true });
      })();
    </script>
  </body>
</html>
