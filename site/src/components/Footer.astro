---
export interface Props { brandName?: string; instagramUrl?: string; email?: string; }
const year = new Date().getFullYear();
const { brandName = "Usagi Délice", instagramUrl = "https://www.instagram.com/usagidelice", email = "usagideliceparis@gmail.com" } = Astro.props as Props;
---

<footer class="site-footer">
  <div class="container footer-main">
    <a class="footer-brand" href="/" aria-label={`${brandName} — Accueil`}>
      <img src="/images/logo.png" alt="" width="50" height="50" loading="lazy" />
      <span><strong>{brandName}</strong><small>Takoyaki artisanal d’Osaka</small></span>
    </a>
    <div class="footer-contact">
      <a href={instagramUrl} rel="noopener noreferrer" target="_blank"><img src="/images/icons/instagram.svg" alt="" width="17" height="17" /> Instagram</a>
      <a href={`mailto:${email}`}>{email}</a>
    </div>
    <p class="footer-area">Paris & Île-de-France<br /><span>Marchés · Festivals · Événements</span></p>
  </div>
  <div class="container footer-bottom">
    <p>© {year} {brandName}. Tous droits réservés.</p>
    <a href="/mentions-legales">Mentions légales</a>
  </div>
</footer>

<style>
  .site-footer { padding: 38px 0 20px; background: #efe3d6; }
  .footer-main { display: grid; grid-template-columns: 1.2fr 1fr 1fr; gap: 35px; align-items: center; }
  .footer-brand { display: flex; gap: 12px; align-items: center; }
  .footer-brand img { width: 50px; height: 50px; border-radius: 50%; }
  .footer-brand span { display: grid; gap: 3px; }
  .footer-brand strong { font-size: 1rem; }
  .footer-brand small, .footer-area span { color: rgba(43, 36, 32, .58); font-size: .78rem; }
  .footer-contact { display: grid; gap: 7px; font-size: .86rem; }
  .footer-contact a:first-child { display: flex; gap: 7px; align-items: center; }
  .footer-contact img { width: 16px; height: 16px; }
  .footer-area { margin: 0; font-size: .87rem; line-height: 1.6; text-align: right; }
  .footer-bottom { display: flex; justify-content: space-between; margin-top: 28px; padding-top: 17px; border-top: 1px solid rgba(43, 36, 32, .1); color: rgba(43, 36, 32, .56); font-size: .74rem; }
  .footer-bottom p { margin: 0; }
  @media (max-width: 720px) {
    .site-footer { padding-top: 34px; }
    .footer-main { grid-template-columns: 1fr; gap: 22px; justify-items: center; text-align: center; }
    .footer-contact { justify-items: center; }
    .footer-area { text-align: center; }
    .footer-bottom { flex-direction: column; gap: 9px; align-items: center; text-align: center; }
  }
</style>
