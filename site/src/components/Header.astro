---
export interface Props { logoSrc?: string; brandName?: string; }

const nav = [
  { href: "/", label: "Accueil" },
  { href: "/evenements", label: "Événements" },
  { href: "/contact", label: "Contact" },
];
const { logoSrc = "/images/logo.png", brandName = "Usagi Délice" } = Astro.props;
const pathname = Astro.url.pathname;
const isActive = (href: string) => href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${brandName} — Accueil`}>
      <img src={logoSrc} alt="" width="44" height="44" loading="eager" />
      <span class="name">{brandName}</span>
    </a>
    <nav class="nav" aria-label="Navigation principale">
      {nav.map((item) => (
        <a href={item.href} class:list={{ active: isActive(item.href) }} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>
      ))}
      <a class="instagram-link" href="https://www.instagram.com/usagidelice" target="_blank" rel="noopener noreferrer">
        <img src="/images/icons/instagram.svg" alt="" width="18" height="18" /><span>Instagram</span>
      </a>
    </nav>
    <button class="menu-btn" type="button" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="mobile-drawer" data-menu-btn>
      <span class="burger" aria-hidden="true"><i></i><i></i><i></i></span>
    </button>
  </div>
  <div class="mobile-drawer" id="mobile-drawer" data-mobile-drawer>
    <div class="container">
      {nav.map((item) => (
        <a href={item.href} class:list={{ active: isActive(item.href) }} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>
      ))}
      <a href="https://www.instagram.com/usagidelice" target="_blank" rel="noopener noreferrer">
        <span>Instagram</span><img src="/images/icons/instagram.svg" alt="" width="18" height="18" />
      </a>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const button = document.querySelector("[data-menu-btn]");
    const drawer = document.querySelector("[data-mobile-drawer]");
    if (!(button instanceof HTMLButtonElement) || !(drawer instanceof HTMLElement)) return;
    const setOpen = (open) => {
      drawer.hidden = !open;
      drawer.style.display = open ? "block" : "none";
      button.setAttribute("aria-expanded", String(open));
      button.setAttribute("aria-label", open ? "Fermer le menu" : "Ouvrir le menu");
    };
    setOpen(false);
    button.addEventListener("click", () => setOpen(button.getAttribute("aria-expanded") !== "true"));
    drawer.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setOpen(false)));
    document.addEventListener("click", (event) => {
      if (button.getAttribute("aria-expanded") !== "true") return;
      if (event.target instanceof Node && !drawer.contains(event.target) && !button.contains(event.target)) setOpen(false);
    });
    window.addEventListener("keydown", (event) => { if (event.key === "Escape") setOpen(false); });
  })();
</script>

<style>
  .site-header { height: 82px; background: rgba(246, 235, 221, .94); border-color: rgba(43, 36, 32, .1); backdrop-filter: blur(16px); }
  .header-inner { height: 100%; }
  .brand { min-width: auto; gap: 12px; }
  .brand img { width: 46px; height: 46px; border-radius: 50%; }
  .brand .name { color: #2b2420; font-size: 1.06rem; font-weight: 850; letter-spacing: -.02em; }
  .nav { display: flex; gap: 2px; margin-left: auto; font-size: .87rem; font-weight: 680; }
  .nav a { position: relative; padding: 10px 13px; }
  .nav a.active::after { position: absolute; right: 13px; bottom: 3px; left: 13px; height: 2px; border-radius: 2px; background: var(--red); content: ""; }
  .instagram-link { display: inline-flex; gap: 7px; align-items: center; margin-left: 6px; }
  .instagram-link img { width: 17px; height: 17px; border-radius: 0; }
  .menu-btn { display: none; border: 0; background: transparent; }
  .burger { display: grid; gap: 5px; }
  .burger i { display: block; width: 25px; height: 2px; border-radius: 2px; background: #2b2420; }
  .mobile-drawer { top: 68px; }
  .mobile-drawer a.active { color: var(--red); }
  .mobile-drawer img { width: 18px; height: 18px; border-radius: 0; }
  @media (max-width: 820px) {
    .site-header { height: 70px; }
    .brand img { width: 40px; height: 40px; }
    .brand .name { font-size: 1rem; }
    .nav { display: none; }
    .menu-btn { display: inline-flex; width: 42px; height: 42px; }
  }
</style>
