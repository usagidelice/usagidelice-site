---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Mentions légales — Usagi Délice";
const description = "Informations légales du site Usagi Délice.";
---

<BaseLayout title={title} description={description}>
  <section class="apple-section">
    <div class="container">
      <span class="badge">Mentions légales</span>
      <h1 class="h1" style="margin-top:14px;">Informations légales</h1>
      <p class="lead" style="max-width:76ch;">
        Informations relatives à l’édition et à l’utilisation du site usagidelice.fr.
      </p>

      <div class="card" style="margin-top:18px;">
        <div class="pad">
          <h2 class="h2">Éditeur du site</h2>
          <p class="small">Nom commercial : Usagi Délice</p>
          <p class="small">Statut : entrepreneur individuel — micro-entreprise artisanale</p>
          <p class="small">Directeur de la publication : Usagi Délice</p>
          <p class="small">Email : contact@usagidelice.fr</p>
          <div class="hr"></div>
          <h2 class="h2">Hébergement</h2>
          <p class="small">Vercel Inc., 340 S Lemon Ave #4133, Walnut, CA 91789, États-Unis.</p>
          <div class="hr"></div>
          <h2 class="h2">Crédits</h2>
          <p class="small">Textes, identité visuelle et photographies : Usagi Délice.</p>
          <div class="hr"></div>
          <h2 class="h2">Données personnelles</h2>
          <p class="small">Les informations envoyées par le formulaire de contact sont utilisées uniquement pour répondre à votre demande. Vous pouvez demander leur accès, leur rectification ou leur suppression à contact@usagidelice.fr.</p>
          <div class="hr"></div>
          <h2 class="h2">Propriété intellectuelle</h2>
          <p class="small">Sauf mention contraire, les contenus de ce site sont la propriété d’Usagi Délice. Toute reproduction ou utilisation sans autorisation préalable est interdite.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
