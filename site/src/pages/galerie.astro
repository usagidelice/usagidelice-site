---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Galerie — Usagi Délice";
const description = "Photos du stand, des takoyaki et des événements. L’ambiance Usagi Délice en images.";

const photos = [
  { src: '/images/references/photos/ref-photo-1.webp', alt: 'Stand Usagi Délice au marché de Noël de La Villette' },
  { src: '/images/references/photos/ref-photo-2.webp', alt: 'Takoyaki d’Osaka servis chauds' },
  { src: '/images/references/photos/ref-photo-3.webp', alt: 'Takoyaki Usagi Délice devant la Tour Eiffel' },
  { src: '/images/references/photos/ref-photo-4.webp', alt: 'Takoyaki Usagi Délice devant l’Arc de Triomphe' },
  { src: '/images/references/photos/ref-photo-5.webp', alt: 'Cuisson des takoyaki sur la plaque' },
  { src: '/images/references/photos/ref-photo-6.webp', alt: 'Préparation des takoyaki devant le public' },
  { src: '/images/references/photos/ref-photo-7.webp', alt: 'Service Usagi Délice pendant un événement fréquenté' },
  { src: '/images/references/photos/ref-photo-8.webp', alt: 'Collaboration Usagi Délice avec UNIQLO Paris' },
  { src: '/images/references/photos/ref-photo-9.webp', alt: 'Stand Usagi Délice en plein air' },
  { src: '/images/references/photos/ref-photo-10.webp', alt: 'Public devant le stand Usagi Délice en festival' }
];
---

<BaseLayout title={title} description={description}>
  <section class="apple-section">
    <div class="container">
      <span class="badge">Galerie</span>
      <h1 class="h1" style="margin-top:14px;">L’ambiance Usagi Délice</h1>
      <p class="lead" style="max-width:72ch;">
        Nos takoyaki, leur préparation en direct et quelques-uns des marchés, festivals et collaborations qui ont marqué notre parcours.
      </p>

      <div class="grid" style="margin-top:18px; grid-template-columns: repeat(2, 1fr);">
        {photos.map((p) => (
          <a class="card" href={p.src} target="_blank" rel="noopener noreferrer">
            <img src={p.src} alt={p.alt} loading="lazy" width="1200" height="900" />
          </a>
        ))}
      </div>

      <div class="card" style="margin-top:18px;">
        <div class="pad">
          <h2 class="h2">Instagram</h2>
          <p class="lead" style="margin:0; max-width:80ch;">
            Pour encore plus de photos et les stories des marchés / festivals.
          </p>
          <div style="margin-top:14px;">
            <a class="btn primary" href="https://www.instagram.com/usagidelice" target="_blank" rel="noopener noreferrer">Voir Instagram</a>
          </div>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
