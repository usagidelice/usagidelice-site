---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';
import { events } from '../data/events';
import { refPhotos } from '../data/references';

const title = "Nous trouver — Usagi Délice";
const description = "Prochaines dates, marchés et événements : retrouvez Usagi Délice à Paris & Île-de-France.";

const upcoming = events.filter(e => e.status === 'upcoming');
const regular = events.filter(e => e.status === 'regular');
// Restore the event gallery used in the earlier site version. The first six
// images keep the same order as the former homepage carousel.
const eventPhotos = refPhotos.slice(0, 6);

const organizers = [
  { name: 'UNIQLO Paris', kind: 'Collaboration', logo: '/images/partners/uniqlo.svg' },
  { name: 'Tang Frères', kind: 'Collaboration' },
  { name: 'Groupe Dadoune', kind: 'Collaboration' },
  { name: 'Japan Fes', kind: 'Festival', logo: '/images/partners/japan-fes.svg' },
  { name: 'Rice Market (Europe Times)', kind: 'Événement', logo: '/images/partners/rice-market.svg' },
  { name: 'Mairie de Vincennes', kind: 'Institution' },
  { name: 'Parc Floral / Vincennes', kind: 'Lieu' },
  { name: 'Parc départemental de Sceaux (92)', kind: 'Lieu' },
  { name: 'Marché de Noël — La Villette', kind: 'Événement', logo: '/images/partners/la-villette-noel.svg' },
];
---

<BaseLayout title={title} description={description}>
  <section class="apple-section events-page">
    <div class="container">
      <span class="badge">Nous trouver</span>
      <h1 class="h1" style="margin-top:14px;">Nos prochaines dates</h1>
      <p class="lead" style="max-width:72ch;">
        Nous sommes un stand itinérant. Voici nos rendez-vous réguliers et nos prochaines dates annoncées.
        Pour les mises à jour de dernière minute, Instagram est le plus rapide.
      </p>

      <div id="prochaines-dates" style="margin-top:26px;"></div>
      <h2 class="h2">Prochaines dates</h2>
      <p class="lead" style="margin-top:6px; max-width:72ch;">Événements et marchés annoncés.</p>
      <div class="grid cols-3" style="margin-top:14px;">
        {(upcoming.length ? upcoming : [{
          title: 'À annoncer',
          dateLabel: 'Prochainement',
          location: 'Paris & Île-de-France',
          status: 'upcoming',
          description: "Suivez-nous sur Instagram : on publie les prochaines dates dès qu’elles sont confirmées."
        }]).map((e) => <EventCard item={e as any} />)}
      </div>

      <div style="margin-top:26px;"></div>
      <h2 class="h2">Rendez-vous réguliers</h2>
      <p class="lead" style="margin-top:6px; max-width:72ch;">Nos marchés habituels.</p>
      <div class="grid cols-3" style="margin-top:14px;">
        {regular.map((e) => <EventCard item={e} />)}
      </div>
    </div>

    <section class="event-gallery" aria-labelledby="event-gallery-title">
      <div class="container">
        <div class="event-section-head">
          <span class="badge">Galerie</span>
          <h2 id="event-gallery-title" class="h2">Ambiance, cuisine, événements</h2>
          <p class="lead">Faites défiler les images de nos stands et événements — swipe sur mobile, ou utilisez les flèches sur ordinateur.</p>
        </div>
      </div>

      <div class="event-gallery__rail-wrap" data-event-gallery>
        <button class="event-gallery__arrow event-gallery__arrow--left" type="button" data-event-gallery-left aria-label="Images précédentes">←</button>
        <button class="event-gallery__arrow event-gallery__arrow--right" type="button" data-event-gallery-right aria-label="Images suivantes">→</button>

        <div class="event-gallery__rail" id="event-photos" data-event-gallery-rail>
          {eventPhotos.map((photo, index) => {
            const id = `event-${photo.id ?? `photo-${index + 1}`}`;
            const shape = photo.shape ?? 'landscape';
            return (
              <a class={`event-shot ${shape}`} href={`#${id}`} aria-label={`Voir : ${photo.caption}`}>
                <img src={photo.src} alt={photo.alt} loading="lazy" width="1400" height="900" />
                <span class="event-shot__tag">{photo.caption}</span>
              </a>
            );
          })}
        </div>
      </div>

      {eventPhotos.map((photo, index) => {
        const id = `event-${photo.id ?? `photo-${index + 1}`}`;
        const next = eventPhotos[(index + 1) % eventPhotos.length];
        const prev = eventPhotos[(index - 1 + eventPhotos.length) % eventPhotos.length];
        const nextId = `event-${next.id ?? `photo-${((index + 1) % eventPhotos.length) + 1}`}`;
        const prevId = `event-${prev.id ?? `photo-${((index - 1 + eventPhotos.length) % eventPhotos.length) + 1}`}`;

        return (
          <section id={id} class="event-lightbox" aria-label={`Agrandir : ${photo.caption}`}>
            <a class="event-lightbox__backdrop" href="#event-photos" aria-label="Fermer" />
            <div class="event-lightbox__card" role="dialog" aria-modal="true">
              <div class="event-lightbox__top">
                <div>
                  <p class="event-lightbox__kicker">Usagi Délice</p>
                  <p class="event-lightbox__caption">{photo.caption}</p>
                </div>
                <a class="event-lightbox__close" href="#event-photos" aria-label="Fermer">✕</a>
              </div>
              <div class="event-lightbox__media">
                <img src={photo.src} alt={photo.alt} />
              </div>
              <div class="event-lightbox__nav">
                <a href={`#${prevId}`} aria-label="Image précédente">←</a>
                <a href={`#${nextId}`} aria-label="Image suivante">→</a>
              </div>
            </div>
          </section>
        );
      })}
    </section>

    <section class="event-organizers" aria-labelledby="event-organizers-title">
      <div class="container">
        <div class="event-section-head">
          <span class="badge">Nos participations</span>
          <h2 id="event-organizers-title" class="h2">Organisateurs & partenaires</h2>
          <p class="lead">Quelques organisateurs, lieux et événements auxquels Usagi Délice a participé.</p>
        </div>

        <div class="event-organizers__grid" role="list">
          {organizers.map((organizer) => (
            <div class="event-organizer" role="listitem">
              {organizer.logo ? (
                <img src={organizer.logo} alt={organizer.name} loading="lazy" />
              ) : (
                <span class="event-organizer__name">{organizer.name}</span>
              )}
              <span class="event-organizer__kind">{organizer.kind}</span>
            </div>
          ))}
        </div>
      </div>
    </section>
  </section>
</BaseLayout>

<style>
  .events-page {
    overflow: hidden;
  }

  .event-section-head {
    max-width: 76ch;
  }

  .event-section-head h2 {
    margin-top: 14px;
  }

  .event-section-head .lead {
    margin-top: 8px;
    margin-bottom: 0;
  }

  .event-gallery {
    padding: 36px 0 18px;
  }

  .event-gallery__rail-wrap {
    position: relative;
    width: min(1680px, calc(100vw - 24px));
    margin: 0 auto;
  }

  .event-gallery__rail {
    display: flex;
    gap: 18px;
    overflow-x: auto;
    padding: 16px max(16px, calc((100vw - var(--container)) / 2)) 30px;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: rgba(42, 31, 31, 0.18) transparent;
  }

  .event-gallery__rail::-webkit-scrollbar {
    height: 6px;
  }

  .event-gallery__rail::-webkit-scrollbar-thumb {
    background: rgba(42, 31, 31, 0.16);
    border-radius: 999px;
  }

  .event-shot {
    position: relative;
    display: block;
    flex: 0 0 auto;
    height: 380px;
    overflow: hidden;
    border: 1px solid rgba(42, 31, 31, 0.1);
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.18);
    color: inherit;
    scroll-snap-align: start;
    outline: none;
    box-shadow: 0 18px 50px rgba(0, 0, 0, var(--event-shot-shadow, 0));
    transform: translateY(var(--event-shot-lift, 0)) scale(var(--event-shot-scale, 1));
    transition: transform 0.22s ease, box-shadow 0.22s ease;
  }

  .event-shot.landscape {
    aspect-ratio: 3 / 2;
  }

  .event-shot.portrait {
    aspect-ratio: 3 / 4;
  }

  .event-shot.square {
    aspect-ratio: 1 / 1;
  }

  .event-shot:hover {
    transform: translateY(calc(var(--event-shot-lift, 0px) - 2px)) scale(var(--event-shot-scale, 1));
  }

  .event-shot:focus-visible {
    outline: 3px solid rgba(194, 59, 50, 0.32);
    outline-offset: 3px;
  }

  .event-shot img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .event-shot:hover img {
      transform: scale(1.03);
    }
  }

  .event-shot__tag {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 12px;
    width: fit-content;
    max-width: calc(100% - 24px);
    padding: 8px 12px;
    overflow: hidden;
    border: 1px solid rgba(42, 31, 31, 0.1);
    border-radius: 999px;
    background: rgba(255, 247, 239, 0.84);
    color: rgba(42, 31, 31, 0.9);
    backdrop-filter: blur(10px);
    font-size: 0.88rem;
    font-weight: 900;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .event-gallery__arrow {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: inline-flex;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(42, 31, 31, 0.14);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.16);
    cursor: pointer;
    opacity: 0;
    transform: translateY(-50%);
    transition: opacity 0.18s ease, transform 0.18s ease;
  }

  .event-gallery__rail-wrap:hover .event-gallery__arrow,
  .event-gallery__arrow:focus-visible {
    opacity: 0.94;
  }

  .event-gallery__arrow--left {
    left: 14px;
  }

  .event-gallery__arrow--right {
    right: 14px;
  }

  .event-gallery__arrow.is-disabled {
    opacity: 0 !important;
    pointer-events: none;
  }

  .event-organizers {
    padding: 28px 0 4px;
  }

  .event-organizers__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-top: 20px;
  }

  .event-organizer {
    display: flex;
    min-height: 112px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 18px;
    border: 1px solid rgba(42, 31, 31, 0.1);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.24);
    text-align: center;
    transition: transform 0.18s ease, background 0.18s ease;
  }

  .event-organizer:hover {
    background: rgba(255, 255, 255, 0.42);
    transform: translateY(-1px);
  }

  .event-organizer img {
    width: auto;
    max-width: 100%;
    height: 46px;
    object-fit: contain;
  }

  .event-organizer__name {
    font-weight: 900;
    line-height: 1.18;
  }

  .event-organizer__kind {
    color: rgba(42, 31, 31, 0.58);
    font-size: 0.84rem;
  }

  .event-lightbox {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: none;
  }

  .event-lightbox:target {
    display: block;
  }

  .event-lightbox__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(20, 16, 16, 0.56);
    backdrop-filter: blur(10px);
  }

  .event-lightbox__card {
    position: relative;
    width: min(var(--container), calc(100% - 28px));
    margin: 14px auto;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 18px;
    background: rgba(255, 247, 239, 0.94);
    box-shadow: 0 30px 90px rgba(0, 0, 0, 0.35);
  }

  .event-lightbox__top,
  .event-lightbox__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 14px;
  }

  .event-lightbox__top {
    border-bottom: 1px solid rgba(42, 31, 31, 0.1);
  }

  .event-lightbox__nav {
    border-top: 1px solid rgba(42, 31, 31, 0.1);
  }

  .event-lightbox__kicker,
  .event-lightbox__caption {
    margin: 0;
  }

  .event-lightbox__kicker {
    color: rgba(42, 31, 31, 0.6);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .event-lightbox__caption {
    margin-top: 2px;
    font-weight: 950;
  }

  .event-lightbox__close,
  .event-lightbox__nav a {
    display: inline-flex;
    min-width: 42px;
    min-height: 38px;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(42, 31, 31, 0.14);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.5);
    color: rgba(42, 31, 31, 0.85);
    font-weight: 900;
  }

  .event-lightbox__media {
    background: rgba(255, 255, 255, 0.35);
  }

  .event-lightbox__media img {
    display: block;
    width: 100%;
    height: min(72vh, 720px);
    object-fit: contain;
    background: rgba(255, 255, 255, 0.18);
  }

  @media (max-width: 860px) {
    .event-gallery__rail {
      padding: 10px 16px 20px;
    }

    .event-gallery__arrow {
      display: none;
    }

    .event-shot {
      height: 290px;
    }

    .event-organizers__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .event-gallery {
      padding-top: 28px;
    }

    .event-organizers__grid {
      grid-template-columns: 1fr;
    }

    .event-lightbox__card {
      margin: 10px auto;
    }

    .event-lightbox__nav {
      display: none;
    }

    .event-lightbox__media img {
      height: min(76vh, 680px);
    }
  }
</style>

<script is:inline>
  (() => {
    const wrap = document.querySelector('[data-event-gallery]');
    const rail = document.querySelector('[data-event-gallery-rail]');
    if (!wrap || !rail) return;

    const leftButton = wrap.querySelector('[data-event-gallery-left]');
    const rightButton = wrap.querySelector('[data-event-gallery-right]');
    const shots = Array.from(rail.querySelectorAll('.event-shot'));

    const isScrollable = () => rail.scrollWidth > rail.clientWidth + 2;
    const updateButtons = () => {
      const canScroll = isScrollable();
      wrap.classList.toggle('is-scrollable', canScroll);
      if (!canScroll) return;
      leftButton?.classList.toggle('is-disabled', rail.scrollLeft <= 2);
      rightButton?.classList.toggle('is-disabled', rail.scrollLeft + rail.clientWidth >= rail.scrollWidth - 2);
    };

    const step = () => rail.clientWidth * 0.84;
    leftButton?.addEventListener('click', () => rail.scrollBy({ left: -step(), behavior: 'smooth' }));
    rightButton?.addEventListener('click', () => rail.scrollBy({ left: step(), behavior: 'smooth' }));

    rail.addEventListener('wheel', (event) => {
      if (!isScrollable()) return;
      if (Math.abs(event.deltaY) > Math.abs(event.deltaX)) {
        rail.scrollLeft += event.deltaY;
        event.preventDefault();
      }
    }, { passive: false });

    let depthFrame = 0;
    const updateDepth = () => {
      depthFrame = 0;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || window.innerWidth < 861) {
        shots.forEach((shot) => {
          shot.style.removeProperty('--event-shot-lift');
          shot.style.removeProperty('--event-shot-scale');
          shot.style.removeProperty('--event-shot-shadow');
        });
        return;
      }

      const railRect = rail.getBoundingClientRect();
      const center = railRect.left + railRect.width / 2;
      const maxDistance = railRect.width * 0.55;
      shots.forEach((shot) => {
        const rect = shot.getBoundingClientRect();
        const distance = Math.abs(center - (rect.left + rect.width / 2));
        const t = Math.max(0, 1 - distance / maxDistance);
        shot.style.setProperty('--event-shot-lift', `${(10 * t).toFixed(2)}px`);
        shot.style.setProperty('--event-shot-scale', `${(1 + 0.02 * t).toFixed(4)}`);
        shot.style.setProperty('--event-shot-shadow', `${(0.22 * t).toFixed(3)}`);
      });
    };

    const scheduleDepth = () => {
      if (depthFrame) return;
      depthFrame = window.requestAnimationFrame(updateDepth);
    };

    rail.addEventListener('scroll', updateButtons, { passive: true });
    rail.addEventListener('scroll', scheduleDepth, { passive: true });
    window.addEventListener('resize', updateButtons, { passive: true });
    window.addEventListener('resize', scheduleDepth, { passive: true });
    updateButtons();
    scheduleDepth();
    window.setTimeout(() => { updateButtons(); scheduleDepth(); }, 120);
  })();
</script>
