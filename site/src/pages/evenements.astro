---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';
import { events } from '../data/events';

const title = "Événements — Usagi Délice";
const description = "Retrouvez Usagi Délice sur les marchés, festivals japonais et événements à Paris et en Île-de-France.";
const upcoming = events.filter(e => e.status === 'upcoming');
const regular = events.filter(e => e.status === 'regular');

const pastEvents = [
  { title: 'RICE Market', years: '2023 · 2024 · 2025', place: 'Paris 13e', note: 'Le Marché Treiz’Asiatique' },
  { title: 'Hanami à Sceaux', years: '2024 · 2025', place: 'Sceaux', note: 'Parc départemental & Ville de Sceaux' },
  { title: 'Japan Fes Paris', years: '2024 · 2025', place: 'Paris', note: 'Plusieurs rendez-vous dans des lieux emblématiques' },
  { title: 'Matsuri Paris', years: '2024 · 2025', place: 'Parc Floral de Paris', note: 'Festival culturel japonais' },
  { title: 'Pop-up Tang Frères', years: 'Fév. – mars 2025', place: 'Paris 13e', note: 'Collaboration éphémère' },
  { title: 'Clermont Geek Convention', years: '2025', place: 'Grande Halle d’Auvergne', note: 'Convention pop culture & Japon' },
  { title: 'Marché de Noël de La Villette', years: '2025', place: 'Paris', note: 'Marché de Noël' },
];

const eventPhotos = [
  { src:'/images/usagi-2026/event-villette.jpg', alt:'Stand Usagi Délice au Marché de Noël de La Villette', caption:'Marché de Noël · La Villette', shape:'portrait' },
  { src:'/images/usagi-2026/event-japanfes.jpg', alt:'Usagi Délice pendant Japan Fes Paris', caption:'Japan Fes · Paris', shape:'portrait' },
  { src:'/images/usagi-2026/event-festival.jpg', alt:'Public devant le stand Usagi Délice lors d’un festival', caption:'Festival · Paris & Île-de-France', shape:'landscape' },
  { src:'/images/usagi-2026/event-stand.jpg', alt:'Stand Usagi Délice installé pour un événement', caption:'Stand itinérant · Usagi Délice', shape:'portrait' },
  { src:'/images/usagi-2026/event-service.jpg', alt:'Préparation et service des takoyaki pendant un événement', caption:'Préparé sur place', shape:'square' },
  { src:'/images/usagi-2026/event-cooking.jpg', alt:'Cuisson des takoyaki sur la plaque Usagi Délice', caption:'Cuisson minute', shape:'landscape' },
];

const partners = [
  { name:'Japan Fes Paris', logo:'/images/partners-official/japan-fes.png' },
  { name:'Matsuri Paris', logo:'/images/partners-official/matsuri-paris.png' },
  { name:'RICE - Le Marché Treiz’Asiatique', logo:'/images/partners-official/rice-market.png' },
  { name:'UNIQLO', logo:'/images/partners-official/uniqlo.png' },
  { name:'Tang Frères', logo:'/images/partners-official/tang-freres.png' },
  { name:'Ville de Sceaux', logo:'/images/partners-official/ville-sceaux.png' },
  { name:'Clermont Geek Convention', logo:'/images/partners-official/clermont-geek.png' },
];
---

<BaseLayout title={title} description={description}>
  <div class="events-page">
    <section class="events-hero" data-snap-long>
      <div class="container events-hero__grid">
        <div>
          <p class="eyebrow">Événements</p>
          <h1>Du takoyaki<br />là où Paris se retrouve.</h1>
          <p class="events-hero__lead">Depuis 2023, Usagi Délice participe à des marchés, festivals japonais et rendez-vous culturels à Paris et en Île-de-France.</p>
          <div class="events-hero__actions">
            <a class="button button--primary" href="#prochaines-dates">Prochaines dates</a>
            <a class="button button--ghost" href="/contact">Inviter Usagi Délice</a>
          </div>
        </div>
        <figure class="events-hero__photo">
          <img src="/images/usagi-2026/event-festival.jpg" alt="Usagi Délice en festival" loading="eager" fetchpriority="high" />
          <figcaption>Paris & Île-de-France · marchés · festivals · collaborations</figcaption>
        </figure>
      </div>
    </section>

    <section class="agenda" id="prochaines-dates">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Agenda</p>
          <h2>Nos prochaines dates</h2>
          <p>Les rendez-vous confirmés. Pour les changements de dernière minute, retrouvez-nous sur Instagram.</p>
        </div>
        <div class="grid cols-3 agenda__grid">
          {upcoming.map((e) => <EventCard item={e} />)}
        </div>
        {regular.length > 0 && (
          <div class="regular-line">
            <span>Rendez-vous régulier</span>
            {regular.map((e) => <strong>{e.title} · {e.dateLabel}</strong>)}
          </div>
        )}
      </div>
    </section>

    <section class="past-events" data-snap-long>
      <div class="container">
        <div class="section-head section-head--split">
          <div>
            <p class="eyebrow">Depuis 2023</p>
            <h2>Quelques événements marquants</h2>
          </div>
          <p>Une sélection de rendez-vous qui racontent le mieux notre parcours — sans transformer la page en longue liste d’archives.</p>
        </div>
        <div class="past-events__grid">
          {pastEvents.map((item, index) => (
            <article class="past-event">
              <span class="past-event__index">{String(index + 1).padStart(2,'0')}</span>
              <div>
                <p class="past-event__years">{item.years}</p>
                <h3>{item.title}</h3>
                <p>{item.note}</p>
              </div>
              <span class="past-event__place">{item.place}</span>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="event-gallery" aria-labelledby="event-gallery-title">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Sur le terrain</p>
          <h2 id="event-gallery-title">Notre stand en images</h2>
          <p>Quelques scènes de service, de cuisson et d’événements.</p>
        </div>
      </div>
      <div class="event-gallery__rail-wrap" data-event-gallery>
        <button class="event-gallery__arrow event-gallery__arrow--left" type="button" data-event-gallery-left aria-label="Images précédentes">←</button>
        <div class="event-gallery__rail" data-event-gallery-rail>
          {eventPhotos.map(photo => (
            <figure class={`event-shot ${photo.shape}`}>
              <img src={photo.src} alt={photo.alt} loading="lazy" />
              <figcaption>{photo.caption}</figcaption>
            </figure>
          ))}
        </div>
        <button class="event-gallery__arrow event-gallery__arrow--right" type="button" data-event-gallery-right aria-label="Images suivantes">→</button>
      </div>
    </section>

    <section class="partners" aria-labelledby="partners-title">
      <div class="container">
        <div class="section-head partners__head">
          <div>
            <p class="eyebrow">Références</p>
            <h2 id="partners-title">Événements & partenaires</h2>
          </div>
          <p>Quelques noms parmi les organisateurs, événements et partenaires avec lesquels nous avons travaillé.</p>
        </div>
        <div class="logo-wall" role="list">
          {partners.map(partner => (
            <div class="logo-wall__item" role="listitem" title={partner.name}>
              <img src={partner.logo} alt={partner.name} loading="lazy" />
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .events-page{overflow:clip;background:var(--bg)}
  .events-page :global(.container){width:min(1180px,100%);padding-inline:clamp(20px,3vw,38px)}
  .eyebrow{margin:0 0 12px;color:var(--red);font-size:.73rem;font-weight:850;letter-spacing:.15em;text-transform:uppercase}
  .events-hero{padding:clamp(58px,7vw,100px) 0 clamp(72px,8vw,116px);border-bottom:1px solid rgba(43,36,32,.1)}
  .events-hero__grid{display:grid;grid-template-columns:minmax(0,.88fr) minmax(480px,1.12fr);gap:clamp(48px,6vw,86px);align-items:center}
  .events-hero h1,.section-head h2{margin:0;color:#2b2420;letter-spacing:-.055em}
  .events-hero h1{font-size:clamp(3.8rem,6.4vw,6.7rem);line-height:.9}
  .events-hero__lead{max-width:52ch;margin:27px 0 0;color:rgba(43,36,32,.7);font-size:1.06rem;line-height:1.72}
  .events-hero__actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}
  .button{display:inline-flex;min-height:48px;align-items:center;justify-content:center;padding:12px 19px;border:1px solid rgba(43,36,32,.18);border-radius:12px;font-weight:800}
  .button--primary{border-color:var(--red);color:#fff;background:var(--red)}
  .button--ghost{background:rgba(255,255,255,.42)}
  .events-hero__photo{position:relative;aspect-ratio:4/3;margin:0;overflow:hidden;border-radius:30px 86px 30px 30px;background:#dfd0c3}
  .events-hero__photo img{width:100%;height:100%;object-fit:cover}
  .events-hero__photo figcaption{position:absolute;left:16px;bottom:16px;padding:9px 13px;border-radius:999px;background:rgba(255,247,239,.88);font-size:.79rem;font-weight:800;backdrop-filter:blur(10px)}
  .agenda,.past-events,.event-gallery,.partners{padding:clamp(78px,8vw,118px) 0}
  .agenda{background:#f1e6da}
  .section-head{max-width:720px}
  .section-head h2{font-size:clamp(2.6rem,4.6vw,4.6rem);line-height:.96}
  .section-head>p:last-child{max-width:62ch;margin:18px 0 0;color:rgba(43,36,32,.64);line-height:1.65}
  .agenda__grid{margin-top:34px}
  .regular-line{display:flex;flex-wrap:wrap;gap:9px 18px;align-items:center;margin-top:28px;padding-top:20px;border-top:1px solid rgba(43,36,32,.13);font-size:.88rem}
  .regular-line span{color:rgba(43,36,32,.54)}
  .past-events{background:#f7f3ec}
  .section-head--split,.partners__head{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.72fr);gap:50px;max-width:none;align-items:end}
  .section-head--split>p:last-child,.partners__head>p:last-child{margin:0}
  .past-events__grid{display:grid;margin-top:42px;border-top:1px solid rgba(43,36,32,.15)}
  .past-event{display:grid;grid-template-columns:54px minmax(0,1fr) minmax(160px,.35fr);gap:22px;align-items:center;padding:25px 3px;border-bottom:1px solid rgba(43,36,32,.15)}
  .past-event__index{color:rgba(43,36,32,.38);font-size:.76rem;font-weight:850;letter-spacing:.08em}
  .past-event__years{margin:0 0 6px;color:var(--red);font-size:.77rem;font-weight:850;text-transform:uppercase;letter-spacing:.04em}
  .past-event h3{margin:0;font-size:clamp(1.3rem,2vw,1.8rem);letter-spacing:-.03em}
  .past-event div>p:last-child{margin:5px 0 0;color:rgba(43,36,32,.56);font-size:.9rem}
  .past-event__place{justify-self:end;color:rgba(43,36,32,.58);font-size:.88rem;text-align:right}
  .event-gallery{background:#2b2420;color:#fff7ef}
  .event-gallery .eyebrow{color:#f1a99b}.event-gallery .section-head h2{color:#fff7ef}.event-gallery .section-head>p:last-child{color:rgba(255,247,239,.65)}
  .event-gallery__rail-wrap{position:relative;width:min(1240px,calc(100vw - 28px));margin:26px auto 0}
  .event-gallery__rail{display:flex;gap:14px;overflow-x:auto;padding:10px 20px 24px;scroll-snap-type:x mandatory;scrollbar-width:none}.event-gallery__rail::-webkit-scrollbar{display:none}
  .event-shot{position:relative;flex:0 0 auto;height:390px;margin:0;overflow:hidden;border-radius:18px;background:#171311;scroll-snap-align:start}.event-shot.landscape{aspect-ratio:3/2}.event-shot.portrait{aspect-ratio:3/4}.event-shot.square{aspect-ratio:1/1}
  .event-shot img{width:100%;height:100%;object-fit:cover}.event-shot figcaption{position:absolute;left:12px;bottom:12px;padding:8px 11px;border-radius:999px;background:rgba(255,247,239,.9);color:#2b2420;font-size:.78rem;font-weight:850}
  .event-gallery__arrow{position:absolute;top:50%;z-index:2;width:42px;height:42px;border:0;border-radius:50%;background:rgba(255,247,239,.9);color:#2b2420;font-size:1.1rem;cursor:pointer;transform:translateY(-50%)}.event-gallery__arrow--left{left:7px}.event-gallery__arrow--right{right:7px}
  .partners{padding-top:86px;background:#f7f3ec}
  .logo-wall{display:flex;flex-wrap:wrap;gap:10px;margin-top:32px}
  .logo-wall__item{display:flex;width:clamp(142px,17vw,188px);height:88px;align-items:center;justify-content:center;padding:17px 22px;border:1px solid rgba(43,36,32,.1);border-radius:14px;background:rgba(255,255,255,.48)}
  .logo-wall__item img{max-width:100%;max-height:48px;object-fit:contain;filter:none}
  @media(max-width:820px){.events-hero{padding-top:38px}.events-hero__grid{display:flex;flex-direction:column;gap:34px;align-items:stretch}.events-hero h1{font-size:clamp(3.6rem,16vw,5rem)}.events-hero__photo{aspect-ratio:1/1.02;border-radius:24px 68px 24px 24px}.section-head--split,.partners__head{display:block}.section-head--split>p:last-child,.partners__head>p:last-child{margin-top:16px}.past-event{grid-template-columns:34px 1fr;gap:14px}.past-event__place{grid-column:2;justify-self:start;margin-top:-8px;text-align:left}.event-shot{height:330px}.event-gallery__arrow{display:none}.logo-wall{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}.logo-wall__item{width:auto;height:78px;padding:14px}.logo-wall__item img{max-height:42px}}
</style>

<script>
  const rail = document.querySelector<HTMLElement>('[data-event-gallery-rail]');
  document.querySelector('[data-event-gallery-left]')?.addEventListener('click', () => rail?.scrollBy({left:-420,behavior:'smooth'}));
  document.querySelector('[data-event-gallery-right]')?.addEventListener('click', () => rail?.scrollBy({left:420,behavior:'smooth'}));
</script>
