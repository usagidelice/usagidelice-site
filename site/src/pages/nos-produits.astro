---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Takoyaki — Usagi Délice";
const description =
  "Découvrez l’histoire du takoyaki, le savoir-faire d’Osaka et l’aventure d’Usagi Délice, de nos premiers marchés à Paris à nos événements en Île-de-France.";

const craftPoints = [
  { number: '01', title: 'Une pâte légère', text: 'Une base préparée pour garder un extérieur délicatement doré et un cœur fondant.' },
  { number: '02', title: 'Un vrai morceau de poulpe', text: 'Chaque takoyaki est garni d’un morceau généreux, comme dans la recette traditionnelle.' },
  { number: '03', title: 'Le geste à la plaque', text: 'Les pièces sont retournées une à une, avec précision, pour obtenir leur forme ronde.' },
  { number: '04', title: 'La finition japonaise', text: 'Sauce takoyaki, mayonnaise japonaise, aonori et copeaux de bonite complètent la dégustation.' },
];

const timeline = [
  { year: '2023', text: 'Naissance d’Usagi Délice et premiers marchés à Paris et en Île-de-France.' },
  { year: '2024–2025', text: 'Participation à des événements japonais, asiatiques et street culture, avec de nouvelles collaborations.' },
  { year: 'Aujourd’hui', text: 'Un stand itinérant qui continue de faire découvrir les takoyaki d’Osaka, préparés en direct.' },
];
---

<BaseLayout title={title} description={description}>
  <div class="takoyaki-page">
    <section class="takoyaki-intro" id="origine" aria-labelledby="origine-title">
      <div class="container takoyaki-intro__grid">
        <div class="takoyaki-intro__copy" data-reveal>
          <p class="eyebrow">Takoyaki · Osaka · depuis 1935</p>
          <h1 id="origine-title">Une bouchée née à Osaka</h1>
          <p class="takoyaki-intro__lead">
            Le takoyaki est l’un des grands symboles de la street food japonaise : une bouchée populaire,
            généreuse et profondément liée à la convivialité d’Osaka.
          </p>
          <p>
            Il apparaît à Osaka en <strong>1935</strong>, créé par Tomekichi Endo, le fondateur de l’enseigne
            Aizuya. Inspiré de préparations plus anciennes comme le choboyaki et le radioyaki, il se répand
            rapidement dans les rues, les marchés et les festivals du Kansai.
          </p>
          <p>
            Depuis, sa recette a peu changé dans son esprit : une pâte versée dans une plaque en fonte,
            un morceau de poulpe au centre et un geste précis pour retourner chaque pièce. Le takoyaki est
            devenu un véritable <strong>métier de la plaque</strong>, à la fois gourmand et spectaculaire.
          </p>
          <a class="text-link" href="#savoir-faire">Découvrir le geste <span aria-hidden="true">↓</span></a>
        </div>

        <figure class="takoyaki-intro__media" data-reveal data-delay="80">
          <img
            src="/images/notre-histoire-2.jpg"
            alt="Le stand Usagi Délice et ses takoyaki en préparation"
            width="2000"
            height="1333"
            loading="eager"
            fetchpriority="high"
          />
          <figcaption>Une spécialité populaire, préparée minute</figcaption>
        </figure>
      </div>

      <div class="container origin-facts" data-reveal data-delay="140" aria-label="Repères sur le takoyaki">
        <div><strong>1935</strong><span>Naissance à Osaka</span></div>
        <div><strong>Osaka</strong><span>La ville du kuidaore</span></div>
        <div><strong>Un geste</strong><span>Chaque boule tournée à la main</span></div>
      </div>
    </section>

    <section class="takoyaki-craft" id="savoir-faire" aria-labelledby="savoir-faire-title">
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Notre façon de faire</p>
          <h2 id="savoir-faire-title">Le goût d’Osaka,<br />jusqu’à Paris</h2>
          <p>
            Chez Usagi Délice, nous préparons des takoyaki dans le style traditionnel d’Osaka pour vous faire
            retrouver, à Paris, le goût et l’énergie d’une vraie échoppe japonaise.
          </p>
        </div>

        <div class="craft-grid">
          <figure class="craft-grid__media" data-reveal>
            <img
              src="/images/product-takoyaki.webp"
              alt="Takoyaki Usagi Délice avec sauce, mayonnaise, aonori et copeaux de bonite"
              width="1400"
              height="934"
              loading="lazy"
            />
            <figcaption>Servis bien chauds, dès la sortie de la plaque</figcaption>
          </figure>

          <div class="craft-grid__content" data-reveal data-delay="80">
            <h3>Une recette maison, un service vivant</h3>
            <p>
              La pâte, la cuisson et le retournement demandent du rythme. Nous travaillons chaque portion sur
              place, devant vous, afin que l’extérieur reste légèrement croustillant et que le cœur conserve
              sa texture fondante.
            </p>

            <div class="craft-points">
              {craftPoints.map((point) => (
                <article class="craft-point">
                  <span>{point.number}</span>
                  <div>
                    <h4>{point.title}</h4>
                    <p>{point.text}</p>
                  </div>
                </article>
              ))}
            </div>

            <p class="allergen-note">
              La recette peut contenir notamment du gluten, des œufs, du poisson, des mollusques et du soja.
              Demandez-nous les informations détaillées sur place ou avant votre événement.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="takoyaki-story" id="usagi-delice" aria-labelledby="usagi-title">
      <div class="container takoyaki-story__grid">
        <div class="takoyaki-story__content" data-reveal>
          <p class="eyebrow">L’histoire d’Usagi Délice</p>
          <h2 id="usagi-title">Faire vivre la street food japonaise ici</h2>
          <p class="takoyaki-story__lead">
            Usagi Délice est né d’une envie simple : partager une spécialité japonaise authentique, dans un
            format chaleureux et accessible, au fil des marchés et des rencontres.
          </p>
          <p>
            Depuis <strong>2023</strong>, nous parcourons Paris et ses alentours avec notre stand itinérant.
            Nous avons participé à de nombreux rendez-vous japonais et asiatiques, à des festivals, des marchés
            de Noël et des collaborations, toujours avec la même volonté : préparer devant le public et transmettre
            l’âme de cette cuisine d’Osaka.
          </p>

          <div class="timeline" aria-label="Les étapes d’Usagi Délice">
            {timeline.map((item) => (
              <div class="timeline__item">
                <span>{item.year}</span>
                <p>{item.text}</p>
              </div>
            ))}
          </div>
        </div>

        <figure class="takoyaki-story__media" data-reveal data-delay="80">
          <img
            src="/images/notre-histoire-4.jpg"
            alt="Le stand Usagi Délice au milieu du public lors d’un événement"
            width="1536"
            height="1024"
            loading="lazy"
          />
          <figcaption>Des marchés aux festivals, une cuisine qui se partage</figcaption>
        </figure>
      </div>
    </section>

    <section class="takoyaki-cta" aria-labelledby="takoyaki-cta-title">
      <div class="container takoyaki-cta__inner" data-reveal>
        <div>
          <p class="eyebrow">À bientôt sur la plaque</p>
          <h2 id="takoyaki-cta-title">Goûter à Osaka à Paris&nbsp;?</h2>
          <p>Retrouvez-nous sur nos prochains marchés ou invitez Usagi Délice à votre événement.</p>
        </div>
        <div class="takoyaki-cta__actions">
          <a class="btn primary" href="/evenements#prochaines-dates">Voir les prochaines dates</a>
          <a class="btn ghost" href="/contact">Parler d’un événement</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .takoyaki-page {
    overflow: clip;
    background: #f7f3ec;
  }

  .takoyaki-page .container {
    width: min(1120px, 100%);
    margin-inline: auto;
    padding-inline: 20px;
  }

  .takoyaki-page .eyebrow {
    margin: 0 0 14px;
    color: var(--red);
    font-size: 0.75rem;
    font-weight: 850;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .takoyaki-page h1,
  .takoyaki-page h2,
  .takoyaki-page h3,
  .takoyaki-page h4,
  .takoyaki-page p {
    margin-top: 0;
  }

  .takoyaki-page h1,
  .takoyaki-page h2 {
    color: #2b2420;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .takoyaki-page h1 {
    max-width: 8ch;
    margin-bottom: 26px;
    font-size: clamp(3.6rem, 6.8vw, 6.7rem);
  }

  .takoyaki-page h2 {
    margin-bottom: 22px;
    font-size: clamp(2.8rem, 5.1vw, 5rem);
  }

  .takoyaki-page h3 {
    margin-bottom: 13px;
    color: #2b2420;
    font-size: clamp(1.6rem, 2.4vw, 2.25rem);
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .takoyaki-page p {
    color: rgba(43, 36, 32, 0.7);
    font-size: 1rem;
    line-height: 1.72;
  }

  .takoyaki-page strong {
    color: #2b2420;
  }

  .takoyaki-intro {
    padding: clamp(60px, 8vw, 112px) 0 clamp(70px, 9vw, 126px);
  }

  .takoyaki-intro__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(420px, 1.12fr);
    gap: clamp(45px, 8vw, 108px);
    align-items: center;
  }

  .takoyaki-intro__copy {
    max-width: 550px;
  }

  .takoyaki-intro__lead {
    margin-bottom: 20px;
    color: #3a312d !important;
    font-size: clamp(1.15rem, 1.65vw, 1.4rem) !important;
    font-weight: 650;
    line-height: 1.52 !important;
  }

  .takoyaki-intro__copy p:not(.eyebrow):not(.takoyaki-intro__lead) {
    margin-bottom: 14px;
  }

  .text-link {
    display: inline-flex;
    gap: 10px;
    align-items: center;
    margin-top: 12px;
    color: var(--red);
    font-weight: 800;
  }

  .text-link span {
    transition: transform 180ms ease;
  }

  .text-link:hover span {
    transform: translateY(3px);
  }

  .takoyaki-intro__media,
  .craft-grid__media,
  .takoyaki-story__media {
    position: relative;
    overflow: hidden;
    margin: 0;
    background: #dfd0c3;
    box-shadow: 0 24px 65px rgba(63, 42, 30, 0.13);
  }

  .takoyaki-intro__media {
    aspect-ratio: 1 / 1.03;
    border-radius: 32px 150px 32px 32px;
  }

  .takoyaki-intro__media img,
  .craft-grid__media img,
  .takoyaki-story__media img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .takoyaki-intro__media img {
    object-position: 50% 52%;
  }

  .takoyaki-intro figure figcaption,
  .craft-grid figure figcaption,
  .takoyaki-story figure figcaption {
    position: absolute;
    right: 14px;
    bottom: 14px;
    left: 14px;
    width: fit-content;
    max-width: calc(100% - 28px);
    padding: 8px 12px;
    border: 1px solid rgba(42, 31, 31, 0.1);
    border-radius: 999px;
    background: rgba(255, 247, 239, 0.84);
    color: rgba(42, 31, 31, 0.86);
    backdrop-filter: blur(10px);
    font-size: 0.82rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .origin-facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    margin-top: clamp(48px, 7vw, 88px);
    padding-top: 22px;
    border-top: 1px solid rgba(43, 36, 32, 0.14);
  }

  .origin-facts div {
    display: grid;
    gap: 5px;
  }

  .origin-facts strong {
    color: #2b2420;
    font-size: 1.08rem;
  }

  .origin-facts span {
    color: rgba(43, 36, 32, 0.58);
    font-size: 0.85rem;
  }

  .takoyaki-craft {
    padding: clamp(76px, 10vw, 132px) 0;
    background: #f1e6da;
  }

  .section-head {
    max-width: 700px;
    margin-bottom: clamp(32px, 5vw, 58px);
  }

  .section-head > p:last-child {
    max-width: 63ch;
    margin-bottom: 0;
    font-size: 1.08rem;
  }

  .craft-grid {
    display: grid;
    grid-template-columns: minmax(330px, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(40px, 7vw, 96px);
    align-items: center;
  }

  .craft-grid__media {
    aspect-ratio: 0.92 / 1;
    border-radius: 32px 32px 140px 32px;
  }

  .craft-grid__media img {
    object-position: 50% 50%;
  }

  .craft-grid__content > p {
    max-width: 58ch;
  }

  .craft-points {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 24px;
    margin-top: 28px;
    border-top: 1px solid rgba(43, 36, 32, 0.14);
  }

  .craft-point {
    display: grid;
    grid-template-columns: 34px 1fr;
    gap: 12px;
    padding: 18px 0 17px;
    border-bottom: 1px solid rgba(43, 36, 32, 0.14);
  }

  .craft-point > span {
    color: var(--red);
    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0.04em;
  }

  .craft-point h4 {
    margin-bottom: 5px;
    color: #2b2420;
    font-size: 0.98rem;
  }

  .craft-point p {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.48;
  }

  .allergen-note {
    margin: 19px 0 0;
    color: rgba(43, 36, 32, 0.55) !important;
    font-size: 0.82rem !important;
    line-height: 1.5 !important;
  }

  .takoyaki-story {
    padding: clamp(78px, 10vw, 138px) 0;
  }

  .takoyaki-story__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(400px, 0.96fr);
    gap: clamp(44px, 8vw, 110px);
    align-items: center;
  }

  .takoyaki-story__content {
    max-width: 590px;
  }

  .takoyaki-story__lead {
    color: #3a312d !important;
    font-size: 1.12rem !important;
    font-weight: 650;
  }

  .timeline {
    margin-top: 30px;
    padding-left: 18px;
    border-left: 2px solid rgba(194, 59, 50, 0.25);
  }

  .timeline__item {
    position: relative;
    padding: 0 0 22px 20px;
  }

  .timeline__item:last-child {
    padding-bottom: 0;
  }

  .timeline__item::before {
    position: absolute;
    top: 4px;
    left: -25px;
    width: 9px;
    height: 9px;
    border: 2px solid #f7f3ec;
    border-radius: 50%;
    background: var(--red);
    box-shadow: 0 0 0 1px rgba(194, 59, 50, 0.25);
    content: "";
  }

  .timeline__item span {
    display: block;
    margin-bottom: 4px;
    color: var(--red);
    font-size: 0.82rem;
    font-weight: 850;
    letter-spacing: 0.04em;
  }

  .timeline__item p {
    margin: 0;
    font-size: 0.94rem;
    line-height: 1.52;
  }

  .takoyaki-story__media {
    aspect-ratio: 1 / 1.02;
    border-radius: 150px 32px 32px 32px;
  }

  .takoyaki-story__media img {
    object-position: 50% 50%;
  }

  .takoyaki-cta {
    padding: 0 0 clamp(70px, 8vw, 110px);
  }

  .takoyaki-cta__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    padding-top: 28px;
    border-top: 1px solid rgba(43, 36, 32, 0.14);
  }

  .takoyaki-cta h2 {
    margin-bottom: 10px;
    font-size: clamp(2.25rem, 4vw, 3.8rem);
  }

  .takoyaki-cta p:not(.eyebrow) {
    margin-bottom: 0;
  }

  .takoyaki-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: flex-end;
  }

  @media (max-width: 900px) {
    .takoyaki-intro__grid,
    .craft-grid,
    .takoyaki-story__grid {
      grid-template-columns: 1fr;
      gap: 38px;
    }

    .takoyaki-intro__copy,
    .takoyaki-story__content {
      max-width: 700px;
    }

    .takoyaki-intro__media,
    .craft-grid__media,
    .takoyaki-story__media {
      width: min(100%, 680px);
      justify-self: center;
    }

    .takoyaki-intro__media {
      aspect-ratio: 1.15 / 1;
    }

    .craft-grid__media {
      order: 2;
      aspect-ratio: 1.18 / 1;
    }

    .craft-grid__content {
      order: 1;
    }

    .takoyaki-story__media {
      aspect-ratio: 1.18 / 1;
    }

    .takoyaki-cta__inner {
      align-items: flex-start;
      flex-direction: column;
    }

    .takoyaki-cta__actions {
      justify-content: flex-start;
    }
  }

  @media (max-width: 620px) {
    .takoyaki-page .container {
      padding-inline: 18px;
    }

    .takoyaki-intro {
      padding-top: 44px;
    }

    .takoyaki-page h1 {
      max-width: 9ch;
      margin-bottom: 21px;
      font-size: clamp(3.2rem, 16vw, 4.7rem);
    }

    .takoyaki-page h2 {
      font-size: clamp(2.55rem, 12vw, 3.55rem);
    }

    .takoyaki-intro__media,
    .craft-grid__media,
    .takoyaki-story__media {
      border-radius: 24px 82px 24px 24px;
    }

    .craft-grid__media {
      border-radius: 24px 24px 82px 24px;
    }

    .takoyaki-story__media {
      border-radius: 82px 24px 24px 24px;
    }

    .origin-facts {
      grid-template-columns: 1fr;
      gap: 17px;
      margin-top: 46px;
    }

    .craft-points {
      grid-template-columns: 1fr;
    }

    .takoyaki-craft,
    .takoyaki-story {
      padding-block: 72px;
    }

    .takoyaki-cta__actions,
    .takoyaki-cta__actions .btn {
      width: 100%;
    }

    .takoyaki-cta__actions .btn {
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .text-link span {
      transition: none;
    }
  }
</style>
