---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Takoyaki — Usagi Délice";
const description =
  "Découvrez l’histoire du takoyaki et l’aventure d’Usagi Délice, de la tradition d’Osaka aux marchés de Paris.";
---

<BaseLayout title={title} description={description}>
  <section class="apple-section story takoyaki-story-page">
    <div class="container">
      <span class="badge">Takoyaki</span>
      <h1 class="h1 story__title">Le goût d’Osaka, à Paris</h1>
      <p class="lead story__lead">
        Une spécialité japonaise née à Osaka, préparée sur place et partagée avec vous depuis 2023.
      </p>

      <div class="story__grid">
        <article class="card story__card" data-reveal>
          <div class="pad story__block">
            <div class="story__text">
              <p class="story__kicker">01 · Origine</p>
              <h2 class="h2">Une spécialité née à Osaka</h2>
              <p class="lead">
                Apparu à Osaka en <strong>1935</strong> grâce à Tomekichi Endo, le takoyaki est devenu
                l’un des grands classiques de la street food japonaise.
              </p>
              <p class="story__short">
                Une pâte fluide, un morceau de poulpe et une plaque chaude : chaque boule est retournée
                à la main. Un geste simple en apparence, précis en réalité.
              </p>
            </div>
            <figure class="story__media">
              <img
                src="/images/takoyaki/cuisson-1.webp"
                alt="Préparation des takoyaki sur le stand Usagi Délice"
                width="1200"
                height="1200"
                loading="eager"
                fetchpriority="high"
              />
              <figcaption>Le geste de la plaque</figcaption>
            </figure>
          </div>
        </article>

        <article class="card story__card" data-reveal data-delay="80">
          <div class="pad story__block story__block--reverse">
            <div class="story__text">
              <p class="story__kicker">02 · Notre façon</p>
              <h2 class="h2">Le style d’Osaka, ici</h2>
              <p class="lead">
                Nous préparons des takoyaki dans le style traditionnel d’Osaka, pour vous faire retrouver
                à Paris une bouchée chaude, fondante et généreuse.
              </p>
              <ul class="story__tags" aria-label="Notre savoir-faire">
                <li>Recette maison</li>
                <li>Cuisson minute</li>
                <li>Un vrai morceau de poulpe</li>
                <li>Sauce &amp; toppings japonais</li>
              </ul>
              <p class="story__note">Préparés devant vous, puis servis dès la sortie de la plaque.</p>
            </div>
            <figure class="story__media">
              <img
                src="/images/takoyaki/produit-2.webp"
                alt="Takoyaki Usagi Délice devant la Tour Eiffel"
                width="900"
                height="1200"
                loading="lazy"
              />
              <figcaption>Osaka à Paris</figcaption>
            </figure>
          </div>
        </article>

        <article class="card story__card" data-reveal data-delay="160">
          <div class="pad story__block">
            <div class="story__text">
              <p class="story__kicker">03 · Usagi Délice</p>
              <h2 class="h2">Depuis 2023, sur les marchés</h2>
              <p class="lead">
                Depuis 2023, notre stand itinérant parcourt Paris et ses alentours.
              </p>
              <p class="story__short">
                Marchés, festivals japonais et asiatiques, marchés de Noël et collaborations :
                nous cuisinons devant le public et transmettons l’âme de la street food d’Osaka.
              </p>
              <div class="story__cta">
                <a class="btn primary" href="/evenements">Voir les prochaines dates</a>
                <a class="btn ghost" href="/contact">Proposer un événement</a>
              </div>
            </div>
            <figure class="story__media">
              <img
                src="/images/takoyaki/stand-1.webp"
                alt="Le stand Usagi Délice lors d’un marché de Noël"
                width="900"
                height="1200"
                loading="lazy"
              />
              <figcaption>Des marchés aux festivals</figcaption>
            </figure>
          </div>
        </article>
      </div>

      <p class="story__allergens">
        Allergènes principaux : gluten, œufs, poisson, mollusques et soja. Informations détaillées sur demande.
      </p>
    </div>
  </section>

  <style>
    .takoyaki-story-page .story__title { margin-top: 14px; max-width: 900px; }
    .takoyaki-story-page .story__lead { max-width: 64ch; }
    .takoyaki-story-page .story__grid { margin-top: 30px; display: grid; gap: 22px; }
    .takoyaki-story-page .story__card { background: rgba(255, 247, 239, .92); }
    .takoyaki-story-page .story__card .pad { padding: clamp(22px, 3.1vw, 38px); }
    .takoyaki-story-page .story__block {
      display: grid;
      grid-template-columns: minmax(0, .8fr) minmax(450px, 1.2fr);
      gap: clamp(24px, 3.8vw, 54px);
      align-items: stretch;
    }
    .takoyaki-story-page .story__block--reverse {
      grid-template-columns: minmax(450px, 1.2fr) minmax(0, .8fr);
    }
    .takoyaki-story-page .story__block--reverse .story__text { order: 2; }
    .takoyaki-story-page .story__block--reverse .story__media { order: 1; }
    .takoyaki-story-page .story__text { align-self: center; max-width: 43ch; }
    .takoyaki-story-page .story__kicker {
      margin: 0 0 12px;
      color: var(--red);
      font-size: .74rem;
      font-weight: 850;
      letter-spacing: .13em;
      text-transform: uppercase;
    }
    .takoyaki-story-page .story__text .h2 { margin-bottom: 18px; }
    .takoyaki-story-page .story__text .lead {
      margin-bottom: 14px;
      font-size: clamp(1.03rem, 1.45vw, 1.2rem);
      line-height: 1.55;
    }
    .takoyaki-story-page .story__short,
    .takoyaki-story-page .story__note { margin: 0; color: var(--muted); line-height: 1.62; }
    .takoyaki-story-page .story__media {
      position: relative;
      min-width: 0;
      min-height: 420px;
      aspect-ratio: 1.12 / 1;
      overflow: hidden;
      margin: 0;
      border-radius: 20px;
      background: #dfd0c3;
    }
    .takoyaki-story-page .story__media img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
    }
    .takoyaki-story-page .story__media figcaption {
      position: absolute;
      left: 14px;
      bottom: 14px;
      width: fit-content;
      max-width: calc(100% - 28px);
      padding: 8px 12px;
      border-radius: 999px;
      border: 1px solid rgba(42, 31, 31, .1);
      background: rgba(255, 247, 239, .86);
      color: rgba(42, 31, 31, .86);
      backdrop-filter: blur(10px);
      font-size: .82rem;
      font-weight: 800;
      line-height: 1.2;
    }
    .takoyaki-story-page .story__tags {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 22px 0 18px;
      padding: 0;
      list-style: none;
    }
    .takoyaki-story-page .story__tags li {
      padding: 8px 12px;
      border-radius: 999px;
      background: rgba(194, 59, 50, .09);
      color: #2b2420;
      font-size: .83rem;
      font-weight: 800;
    }
    .takoyaki-story-page .story__cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 22px; }
    .takoyaki-story-page .story__allergens {
      margin: 18px 0 0;
      color: rgba(42, 31, 31, .54);
      font-size: .82rem;
      line-height: 1.5;
    }
    @media (max-width: 880px) {
      .takoyaki-story-page .story__block,
      .takoyaki-story-page .story__block--reverse { grid-template-columns: 1fr; gap: 20px; }
      .takoyaki-story-page .story__block--reverse .story__text,
      .takoyaki-story-page .story__block--reverse .story__media { order: initial; }
      .takoyaki-story-page .story__text { max-width: none; }
      .takoyaki-story-page .story__media { min-height: 0; aspect-ratio: 1.25 / 1; }
    }
    @media (max-width: 520px) {
      .takoyaki-story-page .story__title { font-size: clamp(2.15rem, 9vw, 3.2rem); }
      .takoyaki-story-page .story__card .pad { padding: 18px; }
      .takoyaki-story-page .story__media { aspect-ratio: 1.12 / 1; border-radius: 16px; }
      .takoyaki-story-page .story__cta { gap: 8px; }
      .takoyaki-story-page .story__cta .btn { width: 100%; justify-content: center; }
    }
  </style>
</BaseLayout>
