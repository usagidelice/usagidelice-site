---
import BaseLayout from "../layouts/BaseLayout.astro";
import { events } from "../data/events";

const title = "Usagi Délice — Takoyaki artisanal d’Osaka à Paris";
const description =
  "Takoyaki artisanal d’Osaka, préparé sur place devant vous depuis 2023, sur les marchés, festivals et événements à Paris.";
const nextDates = events.filter((event) => event.status === "upcoming").slice(0, 3);
---

<BaseLayout title={title} description={description}>
  <div class="home">
    <section class="hero-home" aria-labelledby="hero-title">
      <div class="container hero-home__grid">
        <div class="hero-home__copy">
          <p class="eyebrow">Takoyaki artisanal · Paris</p>
          <h1 id="hero-title">USAGI<br />DÉLICE</h1>
          <p class="hero-home__lead">
            Takoyaki artisanal d’Osaka,<br class="desktop-break" /> préparé sur place, devant vous.
          </p>
          <p class="hero-home__places">Paris · Marchés · Festivals · Événements</p>
          <div class="hero-home__actions">
            <a class="home-button home-button--primary" href="#takoyaki">Découvrir</a>
            <a class="home-button home-button--secondary" href="#prochaines-dates">Voir les événements</a>
          </div>
        </div>

        <div class="hero-carousel" data-hero-carousel aria-label="Usagi Délice en images">
          <div class="hero-carousel__viewport">
            <div class="hero-carousel__track" data-hero-carousel-track>
              <figure class="hero-carousel__slide is-active">
                <img src="/images/usagi-2026/home-stand.jpg" alt="Stand Usagi Délice en service à Paris" loading="eager" fetchpriority="high" />
              </figure>
              <figure class="hero-carousel__slide">
                <img src="/images/usagi-2026/home-cooking.jpg" alt="Préparation des takoyaki sur le stand Usagi Délice" loading="eager" />
              </figure>
              <figure class="hero-carousel__slide">
                <img src="/images/usagi-2026/home-paris.jpg" alt="Takoyaki Usagi Délice à Paris" loading="lazy" />
              </figure>
              <figure class="hero-carousel__slide">
                <img src="/images/product-takoyaki.webp" alt="Takoyaki Usagi Délice prêts à déguster" loading="lazy" />
              </figure>
              <figure class="hero-carousel__slide">
                <img src="/images/usagi-2026/home-team.jpg" alt="Membre de l’équipe Usagi Délice au stand" loading="lazy" />
              </figure>
            </div>
          </div>
          <button class="hero-carousel__arrow hero-carousel__arrow--prev" type="button" data-hero-carousel-prev aria-label="Image précédente">←</button>
          <button class="hero-carousel__arrow hero-carousel__arrow--next" type="button" data-hero-carousel-next aria-label="Image suivante">→</button>
          <div class="hero-carousel__dots" aria-label="Choisir une image">
            <button type="button" class="is-active" data-hero-carousel-dot="0" aria-label="Image 1" aria-current="true"></button>
            <button type="button" data-hero-carousel-dot="1" aria-label="Image 2"></button>
            <button type="button" data-hero-carousel-dot="2" aria-label="Image 3"></button>
            <button type="button" data-hero-carousel-dot="3" aria-label="Image 4"></button>
            <button type="button" data-hero-carousel-dot="4" aria-label="Image 5"></button>
          </div>
        </div>
      </div>
    </section>

    <section class="takoyaki-section" id="takoyaki" aria-labelledby="takoyaki-title">
      <div class="container takoyaki-section__grid">
        <div class="takoyaki-section__copy">
          <p class="eyebrow">Notre spécialité</p>
          <h2 id="takoyaki-title">Le takoyaki,<br />comme à Osaka</h2>
          <p>
            Une pâte légère, du poulpe tendre et une cuisson maîtrisée : nos takoyaki sont
            préparés à la minute, devant vous, dans le respect de la tradition d’Osaka.
          </p>
          <aside class="takoyaki-section__history" aria-label="Origine du takoyaki">
            <strong>1935</strong>
            <p>Né à Osaka, le takoyaki devient l’un des emblèmes de la street food japonaise.</p>
          </aside>
          <a class="text-link" href="#notre-histoire">Découvrir notre histoire <span aria-hidden="true">→</span></a>

          <ul class="benefits" aria-label="Nos engagements">
            <li><strong>1935</strong><span>Né à Osaka</span></li>
            <li><strong>À la minute</strong><span>Tourné devant vous</span></li>
            <li><strong>Depuis 2023</strong><span>Sur les marchés</span></li>
          </ul>
        </div>
        <figure class="takoyaki-section__image">
          <img src="/images/usagi-2026/home-takoyaki.jpg" alt="Une portion de takoyaki faite maison" loading="lazy" />
        </figure>
      </div>
    </section>

    <section class="cooking-section" aria-labelledby="cooking-title">
      <div class="container cooking-section__inner">
        <div class="section-heading section-heading--center">
          <p class="eyebrow">Préparé devant vous</p>
          <h2 id="cooking-title">La cuisson fait partie<br />de l’expérience</h2>
          <p>Regardez les takoyaki prendre forme, un à un, sur notre plaque.</p>
        </div>
        <div class="cooking-video">
          <video autoplay muted loop playsinline preload="metadata" poster="/images/references/photos/ref-photo-5.webp" aria-label="Cuisson des takoyaki sur la plaque" data-cooking-video>
            <source src="/videos/cuisson-takoyaki.mp4" type="video/mp4" />
          </video>
        </div>
      </div>
    </section>

    <section class="story-section" id="notre-histoire" aria-labelledby="story-title">
      <div class="container story-compact">
        <div class="story-compact__copy">
          <p class="eyebrow">Notre histoire</p>
          <h2 id="story-title">D’Osaka aux marchés de Paris</h2>
          <p>Depuis 2023, nous préparons nos takoyaki devant le public, sur les marchés, festivals et événements. Une recette simple à comprendre : du goût, du geste et le plaisir de voir la cuisson en direct.</p>
          <a class="text-link" href="/evenements">Découvrir nos événements <span aria-hidden="true">→</span></a>
        </div>
        <figure class="story-compact__image">
          <img src="/images/notre-histoire-1.jpg" alt="Le stand Usagi Délice entouré de clients sur un marché" loading="lazy" />
        </figure>
      </div>
    </section>

    <section class="events-section" id="prochaines-dates" aria-labelledby="events-title">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Agenda</p>
          <h2 id="events-title">Retrouvez-nous<br />prochainement</h2>
        </div>
        <div class="event-list">
          {nextDates.map((event) => (
            <article class="event-card">
              <p class="event-card__date">{event.dateLabel}</p>
              <div>
                <h3>{event.title}</h3>
                <p>{event.location}</p>
              </div>
              <a href="/evenements#prochaines-dates" aria-label={`Voir les détails de ${event.title}`}><span aria-hidden="true">→</span></a>
            </article>
          ))}
        </div>
        <div class="events-section__action">
          <a class="text-link events-section__link" href="/evenements">Voir tous les événements <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="contact-band" aria-labelledby="contact-title">
      <div class="container contact-band__inner">
        <img src="/images/logo.png" alt="Mascotte lapin Usagi Délice" loading="lazy" />
        <div>
          <p class="eyebrow">Parlons de votre projet</p>
          <h2 id="contact-title">Un événement, un marché,<br />une collaboration&nbsp;?</h2>
          <p>Usagi Délice se déplace à Paris et en Île-de-France.</p>
        </div>
        <a class="home-button home-button--primary" href="/contact">Nous contacter</a>
      </div>
    </section>
  </div>

  <script>
    const video = document.querySelector<HTMLVideoElement>("[data-cooking-video]");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const updateVideo = () => {
      if (!video) return;
      if (reducedMotion.matches) {
        video.pause();
        video.removeAttribute("autoplay");
        video.currentTime = 0;
      } else {
        video.setAttribute("autoplay", "");
        video.play().catch(() => {});
      }
    };
    updateVideo();
    reducedMotion.addEventListener?.("change", updateVideo);

    const carousel = document.querySelector<HTMLElement>("[data-hero-carousel]");
    const track = carousel?.querySelector<HTMLElement>("[data-hero-carousel-track]");
    const slides = Array.from(carousel?.querySelectorAll<HTMLElement>(".hero-carousel__slide") ?? []);
    const dots = Array.from(carousel?.querySelectorAll<HTMLButtonElement>("[data-hero-carousel-dot]") ?? []);
    const prev = carousel?.querySelector<HTMLButtonElement>("[data-hero-carousel-prev]");
    const next = carousel?.querySelector<HTMLButtonElement>("[data-hero-carousel-next]");
    let activeSlide = 0;
    let carouselTimer: number | undefined;

    const showSlide = (index: number) => {
      if (!track || !slides.length) return;
      activeSlide = (index + slides.length) % slides.length;
      track.style.transform = `translateX(-${activeSlide * 100}%)`;
      slides.forEach((slide, i) => slide.classList.toggle("is-active", i === activeSlide));
      dots.forEach((dot, i) => {
        const active = i === activeSlide;
        dot.classList.toggle("is-active", active);
        if (active) dot.setAttribute("aria-current", "true");
        else dot.removeAttribute("aria-current");
      });
    };

    const stopCarousel = () => {
      if (carouselTimer !== undefined) window.clearInterval(carouselTimer);
      carouselTimer = undefined;
    };

    const startCarousel = () => {
      stopCarousel();
      if (reducedMotion.matches || slides.length < 2) return;
      carouselTimer = window.setInterval(() => showSlide(activeSlide + 1), 4500);
    };

    prev?.addEventListener("click", () => { showSlide(activeSlide - 1); startCarousel(); });
    next?.addEventListener("click", () => { showSlide(activeSlide + 1); startCarousel(); });
    dots.forEach((dot) => dot.addEventListener("click", () => {
      showSlide(Number(dot.dataset.heroCarouselDot ?? 0));
      startCarousel();
    }));
    carousel?.addEventListener("mouseenter", stopCarousel);
    carousel?.addEventListener("mouseleave", startCarousel);
    reducedMotion.addEventListener?.("change", startCarousel);
    showSlide(0);
    startCarousel();
  </script>



  <style>
    :global(html) {
      scroll-padding-top: 82px;
    }
    .home { overflow: clip; background: var(--bg); }
    .home :global(.container) { width: min(1240px, 100%); padding-inline: clamp(22px, 3vw, 42px); }
    .eyebrow { margin: 0 0 13px; color: var(--red); font-size: .75rem; font-weight: 850; letter-spacing: .15em; text-transform: uppercase; }
    .home-button { display: inline-flex; min-height: 48px; align-items: center; justify-content: center; padding: 12px 20px; border: 1px solid rgba(43, 36, 32, .18); border-radius: 12px; font-size: .93rem; font-weight: 780; transition: transform .2s ease, background .2s ease, border-color .2s ease; }
    .home-button--primary { border-color: var(--red); color: #fff; background: var(--red); }
    .home-button--secondary { background: rgba(255, 255, 255, .52); }
    .text-link { display: inline-flex; gap: 10px; align-items: center; margin-top: 22px; color: var(--red); font-weight: 800; }
    .hero-home { padding: clamp(64px, 7vw, 104px) 0 clamp(84px, 8vw, 126px); border-bottom: 1px solid rgba(43, 36, 32, .09); }
    .hero-home__grid { display: grid; grid-template-columns: minmax(350px, .78fr) minmax(620px, 1.22fr); gap: clamp(48px, 6vw, 88px); align-items: center; }
    .hero-home__copy { max-width: 430px; transform: translateY(-10px); }
    .hero-home__copy h1 { margin: 0; color: #2b2420; font-size: clamp(5.2rem, 7.4vw, 7.6rem); line-height: .95; letter-spacing: -.078em; }
    .hero-home__lead { margin: 27px 0 0; color: #3a312d; font-size: clamp(1.15rem, 1.55vw, 1.38rem); font-weight: 650; line-height: 1.48; }
    .hero-home__places { margin: 9px 0 0; color: rgba(43, 36, 32, .6); font-size: .88rem; }
    .hero-home__actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }
    .hero-carousel { position: relative; min-width: 0; }
    .hero-carousel__viewport { height: clamp(550px, 46vw, 670px); overflow: hidden; border-radius: 32px 96px 32px 32px; background: #dfd0c3; box-shadow: 0 20px 48px rgba(63, 42, 30, .1); }
    .hero-carousel__track { display: flex; width: 100%; height: 100%; transition: transform .62s cubic-bezier(.22,.7,.28,1); will-change: transform; }
    .hero-carousel__slide { flex: 0 0 100%; width: 100%; height: 100%; margin: 0; overflow: hidden; }
    .hero-carousel__slide img, .takoyaki-section__image img { width: 100%; height: 100%; display: block; object-fit: cover; }
    .hero-carousel__slide:nth-child(1) img { object-position: 50% 45%; }
    .hero-carousel__slide:nth-child(2) img { object-position: 50% 48%; }
    .hero-carousel__slide:nth-child(3) img { object-position: 50% 48%; }
    .hero-carousel__slide:nth-child(4) img { object-position: 50% 50%; }
    .hero-carousel__slide:nth-child(5) img { object-position: 50% 42%; }
    .hero-carousel__arrow { position: absolute; top: 50%; z-index: 2; display: grid; width: 42px; height: 42px; place-items: center; border: 1px solid rgba(43,36,32,.1); border-radius: 50%; color: #2b2420; background: rgba(255,247,239,.86); box-shadow: 0 8px 22px rgba(43,36,32,.13); cursor: pointer; opacity: 0; transform: translateY(-50%); transition: opacity .2s ease, transform .2s ease; backdrop-filter: blur(8px); }
    .hero-carousel:hover .hero-carousel__arrow, .hero-carousel__arrow:focus-visible { opacity: .96; }
    .hero-carousel__arrow--prev { left: 14px; }
    .hero-carousel__arrow--next { right: 14px; }
    .hero-carousel__dots { position: absolute; right: 0; bottom: -26px; left: 0; z-index: 2; display: flex; justify-content: center; gap: 8px; }
    .hero-carousel__dots button { width: 7px; height: 7px; padding: 0; border: 0; border-radius: 50%; background: rgba(43,36,32,.22); cursor: pointer; transition: width .2s ease, border-radius .2s ease, background .2s ease; }
    .hero-carousel__dots button.is-active { width: 22px; border-radius: 999px; background: var(--red); }
    .takoyaki-section { padding: clamp(98px, 9vw, 142px) 0; background: #f1e6da; }
    .takoyaki-section__grid { display: grid; grid-template-columns: minmax(0, .88fr) minmax(460px, 1.12fr); gap: clamp(55px, 8vw, 115px); align-items: center; }
    .takoyaki-section__copy { max-width: 520px; }
    .takoyaki-section h2, .section-heading h2, .contact-band h2 { margin: 0; color: #2b2420; font-size: clamp(2.8rem, 4.7vw, 4.7rem); line-height: .95; letter-spacing: -.05em; }
    .takoyaki-section__copy > p:not(.eyebrow) { margin: 26px 0 0; color: rgba(43, 36, 32, .74); font-size: 1.06rem; line-height: 1.72; }
    .takoyaki-section__history { display: grid; grid-template-columns: auto 1fr; gap: 18px; align-items: start; margin: 30px 0 0; padding: 2px 0 2px 18px; border-left: 2px solid var(--red); }
    .takoyaki-section__history strong { color: var(--red); font-size: 1.5rem; line-height: 1; letter-spacing: -.035em; }
    .takoyaki-section__history p { margin: 0; color: rgba(43, 36, 32, .64); font-size: .92rem; line-height: 1.55; }
    .benefits { display: grid; grid-template-columns: repeat(3, 1fr); gap: 13px; margin: 36px 0 0; padding: 27px 0 0; border-top: 1px solid rgba(43, 36, 32, .13); list-style: none; }
    .benefits li { display: grid; gap: 5px; }
    .benefits strong { font-size: .87rem; }
    .benefits span { color: rgba(43, 36, 32, .58); font-size: .78rem; line-height: 1.4; }
    .takoyaki-section__image { height: clamp(470px, 48vw, 650px); border-radius: 30px 96px 30px 30px; box-shadow: 0 20px 48px rgba(63, 42, 30, .11); }
    .cooking-section { padding: clamp(104px, 9vw, 148px) 0; color: #fff7ef; background: #2b2420; }
    .cooking-section__inner { display: grid; gap: 46px; }
    .section-heading { max-width: 720px; }
    .section-heading--center { justify-self: center; text-align: center; }
    .section-heading > p:not(.eyebrow) { margin: 20px 0 0; color: rgba(43, 36, 32, .66); font-size: 1.03rem; line-height: 1.65; }
    .cooking-section .eyebrow { color: #f0a797; }
    .cooking-section .section-heading h2 { color: #fff7ef; }
    .cooking-section .section-heading > p:not(.eyebrow) { color: rgba(255, 247, 239, .68); }
    .cooking-video { position: relative; aspect-ratio: 16 / 8.2; overflow: hidden; border: 1px solid rgba(255, 247, 239, .12); border-radius: 28px; background: #171311; box-shadow: none; }
    .cooking-video::after { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(20, 13, 10, .02), rgba(20, 13, 10, .18)); content: ""; pointer-events: none; }
    .cooking-video video { width: 100%; height: 100%; object-fit: cover; }
    .story-section { padding: clamp(100px, 9vw, 144px) 0; background: #f7f3ec; }
    .story-section__heading { max-width: 800px; margin-bottom: 54px; }
    .story-section__heading > p:last-child { max-width: 63ch; }
    .story-section__grid { display: grid; gap: 34px; }
    .story-card {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      min-height: 430px;
      overflow: hidden;
      border-top: 1px solid rgba(43, 36, 32, .13);
      padding-top: 34px;
      background: transparent;
    }
    .story-card--reverse { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .story-card--reverse .story-card__copy { order: 1; }
    .story-card--reverse .story-card__media { order: 2; }
    .story-card__media { position: relative; min-height: 100%; margin: 0; overflow: hidden; border-radius: 24px 72px 24px 24px; background: #dfd0c3; }
    .story-card--reverse .story-card__media { border-radius: 72px 24px 24px 24px; }
    .story-card__media img { width: 100%; height: 100%; display: block; object-fit: cover; transition: transform .5s ease; }
    .story-card:hover .story-card__media img { transform: scale(1.025); }
    .story-card__copy { align-self: center; padding: clamp(32px, 4vw, 60px); }
    .story-card__number { margin: 0 0 13px; color: var(--red); font-size: .76rem; font-weight: 850; letter-spacing: .14em; }
    .story-card__copy h3 { margin: 0; color: #2b2420; font-size: clamp(2rem, 3.5vw, 3.65rem); line-height: .99; letter-spacing: -.055em; }
    .story-card__copy p:not(.story-card__number) { max-width: 54ch; margin: 22px 0 0; color: rgba(43, 36, 32, .68); font-size: 1rem; line-height: 1.72; }
    .story-card__copy .text-link { margin-top: 24px; }
    .story-timeline {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin-top: 28px;
      padding: 22px 0 0;
      border-top: 1px solid rgba(43, 36, 32, .13);
    }
    .story-timeline div { display: grid; gap: 5px; }
    .story-timeline strong { color: var(--red); font-size: 1.02rem; }
    .story-timeline span { color: rgba(43, 36, 32, .6); font-size: .84rem; line-height: 1.45; }
    .story-promise {
      display: grid;
      grid-template-columns: minmax(240px, .72fr) minmax(0, 1.28fr);
      gap: 30px;
      align-items: end;
      margin-top: 34px;
      padding: 28px 30px;
      border-radius: 24px;
      background: #2b2420;
    }
    .story-promise .eyebrow { margin-bottom: 10px; color: #f3b5a5; }
    .story-promise h3 { margin: 0; color: #fff7ef; font-size: clamp(1.7rem, 3vw, 2.65rem); line-height: 1; letter-spacing: -.045em; }
    .story-promise > p { margin: 0; color: rgba(255, 247, 239, .76); font-size: 1rem; line-height: 1.65; }
    .events-section { padding: clamp(96px, 9vw, 136px) 0; background: #f1e6da; }
    .event-list { display: grid; margin-top: 45px; border-top: 1px solid rgba(43, 36, 32, .16); }
    .event-card { display: grid; grid-template-columns: minmax(185px, .7fr) minmax(0, 1.3fr) 46px; gap: 28px; align-items: center; min-height: 132px; padding: 22px 4px; border-bottom: 1px solid rgba(43, 36, 32, .16); }
    .event-card__date { margin: 0; color: var(--red); font-size: .78rem; font-weight: 850; letter-spacing: .05em; text-transform: uppercase; }
    .event-card h3 { margin: 0 0 6px; font-size: clamp(1.25rem, 2vw, 1.7rem); letter-spacing: -.03em; }
    .event-card div p { margin: 0; color: rgba(43, 36, 32, .62); font-size: .94rem; }
    .event-card > a { display: flex; width: 38px; height: 38px; align-items: center; justify-content: center; justify-self: end; border: 1px solid rgba(43, 36, 32, .16); border-radius: 50%; color: #2b2420; background: transparent; font-weight: 900; transition: color .2s ease, background .2s ease, border-color .2s ease, transform .2s ease; }
    .events-section__action { margin-top: 22px; text-align: left; }
    .events-section__link { margin-top: 0; font-size: .92rem; }
    .contact-band { padding: clamp(82px, 7vw, 112px) 0; color: #fff7ef; background: #b43b32; }
    .contact-band__inner { display: grid; grid-template-columns: 128px 1fr auto; gap: clamp(30px, 5vw, 66px); align-items: center; }
    .contact-band img { width: 128px; height: 128px; border: 1px solid rgba(255, 247, 239, .24); border-radius: 50%; object-fit: cover; background: rgba(255,255,255,.08); }
    .contact-band .eyebrow { color: #ffd7cc; }
    .contact-band h2 { color: #fff7ef; font-size: clamp(2.5rem, 4.3vw, 4.3rem); }
    .contact-band div > p:not(.eyebrow) { margin: 16px 0 0; color: rgba(255, 247, 239, .78); }
    .contact-band .home-button--primary { border-color: #fff7ef; color: #2b2420; background: #fff7ef; }
    @media (hover: hover) and (pointer: fine) {
      .home-button:hover { transform: translateY(-2px); }
      .home-button--primary:hover { border-color: #a73028; background: #a73028; }
      .home-button--secondary:hover { border-color: rgba(43, 36, 32, .32); background: #fff; }
      .text-link:hover span { transform: translateX(3px); }
      .event-card:hover > a { border-color: var(--red); color: #fff; background: var(--red); transform: translateX(2px); }
      .contact-band .home-button--primary:hover { border-color: #fff7ef; color: #2b2420; background: #fff7ef; transform: translateY(-2px); }
    }
    .story-compact { display:grid; grid-template-columns:minmax(0,.82fr) minmax(430px,1.18fr); gap:clamp(52px,7vw,96px); align-items:center; }
    .story-compact__copy { max-width:560px; }
