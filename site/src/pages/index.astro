---
import BaseLayout from "../layouts/BaseLayout.astro";
import { events } from "../data/events";

const title = "Usagi Délice — Takoyaki artisanal d’Osaka à Paris";
const description =
  "Takoyaki artisanal d’Osaka, préparé sur place devant vous, sur les marchés, festivals et événements à Paris.";
const nextDates = events.filter((event) => event.status === "upcoming").slice(0, 3);
---

<BaseLayout title={title} description={description}>
  <div class="home">
    <section class="hero-home" aria-labelledby="hero-title">
      <div class="container hero-home__grid">
        <div class="hero-home__copy">
          <p class="eyebrow">Takoyaki artisanal · Paris</p>
          <h1 id="hero-title">USAGI<br />DÉLICE</h1>
          <p class="hero-home__lead">
            Takoyaki artisanal d’Osaka,<br class="desktop-break" /> préparé sur place, devant vous.
          </p>
          <p class="hero-home__places">Paris · Marchés · Festivals · Événements</p>
          <div class="hero-home__actions">
            <a class="home-button home-button--primary" href="#takoyaki">Découvrir</a>
            <a class="home-button home-button--secondary" href="#prochaines-dates">Voir les événements</a>
          </div>
        </div>

        <div class="hero-collage" aria-label="Usagi Délice en images">
          <figure class="hero-collage__main">
            <img src="/images/references/photos/ref-photo-6.webp" alt="Préparation des takoyaki sur le stand Usagi Délice" loading="eager" fetchpriority="high" />
          </figure>
          <div class="hero-collage__support">
            <figure><img src="/images/product-takoyaki.webp" alt="Takoyaki Usagi Délice prêts à déguster" loading="eager" /></figure>
            <figure><img src="/images/references/photos/ref-photo-7.webp" alt="Stand Usagi Délice pendant un événement" loading="eager" /></figure>
            <figure><img src="/images/references/photos/ref-photo-3.webp" alt="Takoyaki Usagi Délice à Paris" loading="lazy" /></figure>
            <figure><img src="/images/references/photos/ref-photo-1.webp" alt="Stand Usagi Délice au marché de Noël" loading="lazy" /></figure>
          </div>
        </div>

        <figure class="hero-mobile-image">
          <img src="/images/product-takoyaki.webp" alt="Takoyaki artisanaux Usagi Délice" loading="eager" fetchpriority="high" />
        </figure>
      </div>
    </section>

    <section class="takoyaki-section" id="takoyaki" aria-labelledby="takoyaki-title">
      <div class="container takoyaki-section__grid">
        <div class="takoyaki-section__copy">
          <p class="eyebrow">Notre spécialité</p>
          <h2 id="takoyaki-title">Le takoyaki,<br />comme à Osaka</h2>
          <p>
            Une pâte légère, du poulpe tendre et une cuisson maîtrisée : nos takoyaki sont
            préparés à la minute, devant vous, dans le respect de la tradition d’Osaka.
          </p>
          <a class="text-link" href="/nos-produits">Découvrir notre takoyaki <span aria-hidden="true">→</span></a>

          <ul class="benefits" aria-label="Nos engagements">
            <li><strong>Recette traditionnelle</strong><span>Inspirée d’Osaka</span></li>
            <li><strong>Fait main</strong><span>Tourné à la main</span></li>
            <li><strong>À Paris</strong><span>Marchés & festivals</span></li>
          </ul>
        </div>
        <figure class="takoyaki-section__image">
          <img src="/images/references/photos/ref-photo-2.webp" alt="Une portion de takoyaki faite maison" loading="lazy" />
        </figure>
      </div>
    </section>

    <section class="cooking-section" aria-labelledby="cooking-title">
      <div class="container cooking-section__inner">
        <div class="section-heading section-heading--center">
          <p class="eyebrow">Préparé devant vous</p>
          <h2 id="cooking-title">La cuisson fait partie<br />de l’expérience</h2>
          <p>Regardez les takoyaki prendre forme, un à un, sur notre plaque.</p>
        </div>
        <div class="cooking-video">
          <video autoplay muted loop playsinline preload="metadata" poster="/images/references/photos/ref-photo-5.webp" aria-label="Cuisson des takoyaki sur la plaque" data-cooking-video>
            <source src="/videos/cuisson-takoyaki.mp4" type="video/mp4" />
          </video>
        </div>
      </div>
    </section>

    <section class="events-section" id="prochaines-dates" aria-labelledby="events-title">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Agenda</p>
          <h2 id="events-title">Retrouvez-nous<br />prochainement</h2>
        </div>
        <div class="event-list">
          {nextDates.map((event) => (
            <article class="event-card">
              <p class="event-card__date">{event.dateLabel}</p>
              <div>
                <h3>{event.title}</h3>
                <p>{event.location}</p>
              </div>
              <a href="/evenements#prochaines-dates" aria-label={`Voir les détails de ${event.title}`}><span aria-hidden="true">→</span></a>
            </article>
          ))}
        </div>
        <div class="events-section__action">
          <a class="home-button home-button--secondary" href="/evenements">Voir tous les événements</a>
        </div>
      </div>
    </section>

    <section class="contact-band" aria-labelledby="contact-title">
      <div class="container contact-band__inner">
        <img src="/images/logo.png" alt="Mascotte lapin Usagi Délice" loading="lazy" />
        <div>
          <p class="eyebrow">Parlons de votre projet</p>
          <h2 id="contact-title">Un événement, un marché,<br />une collaboration&nbsp;?</h2>
          <p>Usagi Délice se déplace à Paris et en Île-de-France.</p>
        </div>
        <a class="home-button home-button--primary" href="/contact">Nous contacter</a>
      </div>
    </section>
  </div>

  <script>
    const video = document.querySelector<HTMLVideoElement>("[data-cooking-video]");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const updateVideo = () => {
      if (!video) return;
      if (reducedMotion.matches) {
        video.pause();
        video.removeAttribute("autoplay");
        video.currentTime = 0;
      } else {
        video.setAttribute("autoplay", "");
        video.play().catch(() => {});
      }
    };
    updateVideo();
    reducedMotion.addEventListener?.("change", updateVideo);
  </script>

  <style>
    .home { overflow: clip; background: #f7f3ec; }
    .home :global(.container) { width: min(1200px, 100%); padding-inline: clamp(20px, 3vw, 40px); }
    .eyebrow { margin: 0 0 13px; color: var(--red); font-size: .75rem; font-weight: 850; letter-spacing: .15em; text-transform: uppercase; }
    .home-button { display: inline-flex; min-height: 46px; align-items: center; justify-content: center; padding: 11px 19px; border: 1px solid rgba(43, 36, 32, .18); border-radius: 999px; font-size: .93rem; font-weight: 780; transition: transform .2s ease, background .2s ease, border-color .2s ease; }
    .home-button--primary { border-color: var(--red); color: #fff; background: var(--red); }
    .home-button--secondary { background: rgba(255, 255, 255, .52); }
    .text-link { display: inline-flex; gap: 10px; align-items: center; margin-top: 22px; color: var(--red); font-weight: 800; }
    .hero-home { padding: clamp(50px, 6.5vw, 90px) 0 clamp(72px, 8vw, 118px); }
    .hero-home__grid { display: grid; grid-template-columns: minmax(330px, .72fr) minmax(600px, 1.28fr); gap: clamp(38px, 5vw, 76px); align-items: center; }
    .hero-home__copy h1 { margin: 0; color: #2b2420; font-size: clamp(4.7rem, 7vw, 7rem); line-height: .78; letter-spacing: -.075em; }
    .hero-home__lead { margin: 30px 0 0; color: #3a312d; font-size: clamp(1.15rem, 1.55vw, 1.38rem); font-weight: 650; line-height: 1.5; }
    .hero-home__places { margin: 11px 0 0; color: rgba(43, 36, 32, .63); font-size: .9rem; }
    .hero-home__actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 27px; }
    .hero-collage { display: grid; grid-template-columns: 58fr 42fr; gap: 12px; height: clamp(520px, 47vw, 650px); }
    .hero-collage figure, .hero-mobile-image, .takoyaki-section__image { margin: 0; overflow: hidden; }
    .hero-collage__main { border-radius: 160px 28px 28px 28px; }
    .hero-collage__support { display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1.08fr .92fr; gap: 12px; }
    .hero-collage__support figure { border-radius: 22px; }
    .hero-collage__support figure:nth-child(2) { border-radius: 22px 120px 22px 22px; }
    .hero-collage__support figure:nth-child(3) { border-radius: 22px 22px 22px 100px; }
    .hero-collage img, .hero-mobile-image img, .takoyaki-section__image img { width: 100%; height: 100%; object-fit: cover; }
    .hero-collage__main img { object-position: 50% 45%; }
    .hero-collage__support figure:nth-child(1) img { object-position: 50% 46%; }
    .hero-collage__support figure:nth-child(2) img { object-position: 50% 44%; }
    .hero-mobile-image { display: none; }
    .takoyaki-section { padding: clamp(80px, 9vw, 132px) 0; background: #f1e6da; }
    .takoyaki-section__grid { display: grid; grid-template-columns: minmax(0, .88fr) minmax(460px, 1.12fr); gap: clamp(55px, 8vw, 115px); align-items: center; }
    .takoyaki-section__copy { max-width: 520px; }
    .takoyaki-section h2, .section-heading h2, .contact-band h2 { margin: 0; color: #2b2420; font-size: clamp(2.8rem, 5vw, 5rem); line-height: .96; letter-spacing: -.055em; }
    .takoyaki-section__copy > p:not(.eyebrow) { margin: 26px 0 0; color: rgba(43, 36, 32, .74); font-size: 1.06rem; line-height: 1.72; }
    .benefits { display: grid; grid-template-columns: repeat(3, 1fr); gap: 13px; margin: 36px 0 0; padding: 27px 0 0; border-top: 1px solid rgba(43, 36, 32, .13); list-style: none; }
    .benefits li { display: grid; gap: 5px; }
    .benefits strong { font-size: .87rem; }
    .benefits span { color: rgba(43, 36, 32, .58); font-size: .78rem; line-height: 1.4; }
    .takoyaki-section__image { height: clamp(470px, 48vw, 650px); border-radius: 30px 150px 30px 30px; box-shadow: 0 24px 65px rgba(63, 42, 30, .13); }
    .cooking-section { padding: clamp(82px, 9vw, 130px) 0; }
    .cooking-section__inner { display: grid; gap: 42px; }
    .section-heading { max-width: 720px; }
    .section-heading--center { justify-self: center; text-align: center; }
    .section-heading > p:not(.eyebrow) { margin: 20px 0 0; color: rgba(43, 36, 32, .66); font-size: 1.03rem; }
    .cooking-video { position: relative; aspect-ratio: 16 / 8.2; overflow: hidden; border-radius: 34px; background: #dfd0c3; box-shadow: 0 24px 60px rgba(52, 37, 29, .14); }
    .cooking-video::after { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(89, 44, 25, .03), rgba(89, 44, 25, .16)); content: ""; pointer-events: none; }
    .cooking-video video { width: 100%; height: 100%; object-fit: cover; }
    .events-section { padding: clamp(80px, 9vw, 125px) 0; background: #f1e6da; }
    .event-list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 45px; }
    .event-card { display: grid; min-height: 235px; align-content: space-between; padding: 25px; border: 1px solid rgba(43, 36, 32, .1); border-radius: 22px; background: rgba(255, 255, 255, .45); }
    .event-card__date { margin: 0; color: var(--red); font-size: .78rem; font-weight: 850; letter-spacing: .04em; text-transform: uppercase; }
    .event-card h3 { margin: 35px 0 7px; font-size: 1.35rem; letter-spacing: -.025em; }
    .event-card div p { margin: 0; color: rgba(43, 36, 32, .62); font-size: .92rem; }
    .event-card > a { display: flex; width: 36px; height: 36px; align-items: center; justify-content: center; justify-self: end; margin-top: 20px; border-radius: 50%; color: #fff; background: var(--red); font-weight: 900; }
    .events-section__action { margin-top: 30px; text-align: center; }
    .contact-band { padding: clamp(65px, 7vw, 100px) 0; }
    .contact-band__inner { display: grid; grid-template-columns: 145px 1fr auto; gap: clamp(30px, 5vw, 70px); align-items: center; }
    .contact-band img { width: 145px; height: 145px; border-radius: 50%; object-fit: cover; }
    .contact-band h2 { font-size: clamp(2.5rem, 4.3vw, 4.3rem); }
    .contact-band div > p:not(.eyebrow) { margin: 16px 0 0; color: rgba(43, 36, 32, .64); }
    @media (hover: hover) and (pointer: fine) {
      .home-button:hover { transform: translateY(-2px); }
      .home-button--primary:hover { border-color: #a73028; background: #a73028; }
      .home-button--secondary:hover { border-color: rgba(43, 36, 32, .32); background: #fff; }
      .text-link:hover span { transform: translateX(3px); }
    }
    @media (max-width: 1050px) {
      .hero-home__grid { grid-template-columns: minmax(290px, .7fr) minmax(530px, 1.3fr); gap: 34px; }
      .hero-collage { height: 540px; }
      .contact-band__inner { grid-template-columns: 110px 1fr auto; gap: 28px; }
      .contact-band img { width: 110px; height: 110px; }
    }
    @media (max-width: 820px) {
      .home :global(.container) { padding-inline: 20px; }
      .hero-home { padding: 34px 0 70px; }
      .hero-home__grid { display: flex; flex-direction: column; gap: 30px; align-items: stretch; }
      .hero-home__copy { text-align: center; }
      .hero-home__copy h1 { font-size: clamp(3.75rem, 19vw, 5.35rem); line-height: .82; }
      .hero-home__lead { margin-top: 23px; font-size: 1.08rem; line-height: 1.48; }
      .desktop-break { display: none; }
      .hero-home__places { font-size: .78rem; }
      .hero-home__actions { justify-content: center; margin-top: 23px; }
      .hero-collage { display: none; }
      .hero-mobile-image { display: block; width: 100%; aspect-ratio: 1 / 1.03; border-radius: 120px 24px 24px 24px; box-shadow: 0 18px 45px rgba(63, 42, 30, .14); }
      .hero-mobile-image img { object-position: 50% 46%; }
      .takoyaki-section { padding: 72px 0; }
      .takoyaki-section__grid { display: flex; flex-direction: column; gap: 34px; align-items: stretch; }
      .takoyaki-section__copy { display: contents; }
      .takoyaki-section__copy .eyebrow { order: 1; margin-bottom: -22px; }
      .takoyaki-section h2 { order: 2; }
      .takoyaki-section__copy > p:not(.eyebrow) { order: 3; margin: -13px 0 0; }
      .takoyaki-section__image { order: 4; height: auto; aspect-ratio: 4 / 3.1; border-radius: 22px 100px 22px 22px; }
      .benefits { order: 5; grid-template-columns: 1fr; gap: 0; margin: 0; padding: 0; border: 0; }
      .benefits li { grid-template-columns: 1fr auto; align-items: center; padding: 15px 0; border-bottom: 1px solid rgba(43, 36, 32, .12); }
      .benefits li:first-child { border-top: 1px solid rgba(43, 36, 32, .12); }
      .benefits span { text-align: right; }
      .text-link { order: 6; justify-self: start; margin-top: -14px; }
      .cooking-section { padding: 72px 0; }
      .cooking-section__inner { gap: 28px; }
      .cooking-video { aspect-ratio: 4 / 3; border-radius: 23px; }
      .section-heading--center { text-align: left; }
      .events-section { padding: 72px 0; }
      .event-list { grid-template-columns: 1fr; gap: 10px; margin-top: 32px; }
      .event-card { grid-template-columns: minmax(98px, .7fr) 1.3fr 36px; min-height: 112px; align-content: center; align-items: center; gap: 15px; padding: 18px; }
      .event-card h3 { margin: 0 0 5px; font-size: 1.04rem; }
      .event-card__date { line-height: 1.45; }
      .event-card > a { justify-self: end; margin: 0; }
      .contact-band { padding: 67px 0 73px; text-align: center; }
      .contact-band__inner { grid-template-columns: 1fr; justify-items: center; gap: 24px; }
      .contact-band img { width: 126px; height: 126px; }
      .contact-band h2 { font-size: clamp(2.35rem, 11vw, 3.3rem); }
      .contact-band .home-button { width: auto; }
    }
    @media (max-width: 430px) {
      .home :global(.container) { padding-inline: 18px; }
      .hero-home__actions { gap: 8px; }
      .home-button { min-height: 44px; padding-inline: 16px; font-size: .87rem; }
      .hero-mobile-image { aspect-ratio: .94 / 1; }
      .takoyaki-section h2, .section-heading h2 { font-size: clamp(2.65rem, 13vw, 3.35rem); }
      .event-card { grid-template-columns: 91px minmax(0, 1fr) 34px; gap: 10px; padding: 15px; }
      .event-card > a { width: 34px; height: 34px; }
    }
    @media (prefers-reduced-motion: reduce) { .home-button, .text-link span { transition: none; } }
  </style>
</BaseLayout>
