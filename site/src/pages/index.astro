---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductShowcase from "../components/ProductShowcase.astro";
import { products } from "../data/products";
import { events } from "../data/events";
import { partners, refPhotos } from "../data/references";

const title = "Usagi Délice — Takoyaki d’Osaka à Paris";
const description = "Takoyaki faits maison, préparés sur place. Retrouvez Usagi Délice sur les marchés et événements à Paris & Île-de-France.";

const nextDates = events.filter((event) => event.status !== "past").slice(0, 3);
const selectedPhotos = refPhotos.slice(0, 6);
---

<BaseLayout title={title} description={description}>
  <main class="home">
    <section class="home-hero">
      <div class="container home-hero__grid">
        <div class="home-hero__copy">
          <span class="badge">Takoyaki d’Osaka · Paris</span>
          <h1>La street food japonaise préparée devant vous.</h1>
          <p>
            Des takoyaki faits maison, dorés à l’extérieur et fondants à l’intérieur,
            cuits à la minute sur les marchés, festivals et événements.
          </p>
          <div class="home-actions">
            <a class="btn primary" href="/evenements">Voir les prochaines dates</a>
            <a class="btn ghost" href="/contact">Proposer un événement</a>
          </div>
          {nextDates[0] && (
            <a class="next-date" href="/evenements#prochaines-dates">
              <span>Prochain rendez-vous</span>
              <strong>{nextDates[0].title}</strong>
              <small>{nextDates[0].dateLabel} · {nextDates[0].location}</small>
            </a>
          )}
        </div>
        <a class="home-hero__media" href="/notre-histoire" aria-label="Découvrir notre histoire">
          <img src="/images/references/photos/ref-photo-1.webp" alt="Stand Usagi Délice au marché de Noël de La Villette" loading="eager" />
          <span>Notre histoire <b>→</b></span>
        </a>
      </div>
    </section>

    <section class="home-section home-section--soft" aria-labelledby="home-product-title">
      <div class="container">
        <div class="section-intro">
          <div>
            <span class="badge">Notre spécialité</span>
            <h2 id="home-product-title">Une carte courte, un produit maîtrisé.</h2>
          </div>
          <a class="section-link" href="/nos-produits">Découvrir le produit →</a>
        </div>
        {products.map((product) => <ProductShowcase product={product} compact />)}
      </div>
    </section>

    <section class="home-section" aria-labelledby="home-dates-title">
      <div class="container">
        <div class="section-intro">
          <div>
            <span class="badge">Nous trouver</span>
            <h2 id="home-dates-title">Les prochains rendez-vous.</h2>
          </div>
          <a class="section-link" href="/evenements">Voir toutes les dates →</a>
        </div>
        <div class="date-preview">
          {nextDates.map((event) => (
            <article>
              <p>{event.dateLabel}</p>
              <h3>{event.title}</h3>
              <span>{event.location}</span>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="home-section home-section--soft" aria-labelledby="home-events-title">
      <div class="container">
        <div class="section-intro">
          <div>
            <span class="badge">Sur le terrain</span>
            <h2 id="home-events-title">Événements & collaborations.</h2>
            <p>Quelques images récentes — la galerie complète reste sur la page dédiée.</p>
          </div>
          <a class="section-link" href="/references">Voir toutes les participations →</a>
        </div>

        <div class="photo-preview">
          {selectedPhotos.map((photo, index) => (
            <a class:list={["photo-preview__item", { "photo-preview__item--wide": index === 0 || index === 5 }]} href="/references#photos">
              <img src={photo.src} alt={photo.alt} loading="lazy" />
              <span>{photo.caption}</span>
            </a>
          ))}
        </div>

        <div class="partner-preview" aria-label="Collaborations et événements">
          {partners.map((partner) => (
            <div><img src={partner.logo} alt={partner.name} loading="lazy" /></div>
          ))}
        </div>
      </div>
    </section>

    <section class="home-cta">
      <div class="container home-cta__box">
        <div>
          <span class="badge">Marché · Festival · Entreprise</span>
          <h2>Vous préparez un événement ?</h2>
          <p>Indiquez-nous la date, le lieu et le nombre de personnes estimé.</p>
        </div>
        <a class="btn primary" href="/contact">Nous contacter</a>
      </div>
    </section>
  </main>

  <style>
    .home { overflow: hidden; }
    .home-hero { padding: clamp(36px, 6vw, 86px) 0 clamp(54px, 8vw, 104px); }
    .home-hero__grid { display: grid; grid-template-columns: minmax(0, .92fr) minmax(380px, 1.08fr); gap: clamp(34px, 6vw, 84px); align-items: center; }
    .home-hero__copy h1 { margin: 18px 0; max-width: 12ch; font-size: clamp(3.15rem, 7vw, 6.7rem); line-height: .91; letter-spacing: -.065em; }
    .home-hero__copy > p { max-width: 56ch; margin: 0; color: var(--muted, #665d58); font-size: clamp(1.04rem, 1.5vw, 1.25rem); line-height: 1.65; }
    .home-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
    .next-date { display: grid; gap: 3px; max-width: 520px; margin-top: 30px; padding: 17px 19px; border: 1px solid rgba(42, 31, 31, .1); border-radius: 18px; color: inherit; text-decoration: none; background: rgba(255,255,255,.36); }
    .next-date span { color: var(--red, #c23b32); font-size: .75rem; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
    .next-date strong { font-size: 1.05rem; }
    .next-date small { color: var(--muted, #665d58); }
    .home-hero__media { position: relative; display: block; min-height: 660px; overflow: hidden; border-radius: 34px; box-shadow: 0 26px 80px rgba(38, 26, 20, .16); }
    .home-hero__media img { width: 100%; height: 100%; min-height: inherit; object-fit: cover; display: block; transition: transform .5s ease; }
    .home-hero__media:hover img { transform: scale(1.025); }
    .home-hero__media span { position: absolute; right: 20px; bottom: 20px; display: flex; gap: 18px; align-items: center; padding: 12px 15px; border-radius: 999px; color: #2a1f1f; background: rgba(255,255,255,.88); backdrop-filter: blur(12px); font-weight: 850; }
    .home-section { padding: clamp(62px, 8vw, 112px) 0; }
    .home-section--soft { background: rgba(255,255,255,.25); }
    .section-intro { display: flex; justify-content: space-between; gap: 24px; align-items: end; margin-bottom: 26px; }
    .section-intro h2, .home-cta h2 { margin: 14px 0 0; max-width: 15ch; font-size: clamp(2.3rem, 5vw, 4.8rem); line-height: .98; letter-spacing: -.05em; }
    .section-intro p { max-width: 58ch; margin: 12px 0 0; color: var(--muted, #665d58); }
    .section-link { flex: 0 0 auto; color: var(--red, #c23b32); font-weight: 850; text-decoration: none; }
    .date-preview { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
    .date-preview article { min-height: 190px; padding: 25px; border: 1px solid rgba(42,31,31,.1); border-radius: 22px; background: rgba(255,255,255,.38); }
    .date-preview p { margin: 0 0 28px; color: var(--red, #c23b32); font-size: .82rem; font-weight: 900; text-transform: uppercase; }
    .date-preview h3 { margin: 0 0 8px; font-size: 1.45rem; line-height: 1.1; }
    .date-preview span { color: var(--muted, #665d58); }
    .photo-preview { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: 245px; gap: 12px; }
    .photo-preview__item { position: relative; overflow: hidden; border-radius: 20px; color: #fff; }
    .photo-preview__item--wide { grid-column: span 2; }
    .photo-preview img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .4s ease; }
    .photo-preview a:hover img { transform: scale(1.035); }
    .photo-preview span { position: absolute; left: 12px; bottom: 12px; max-width: calc(100% - 24px); padding: 7px 10px; border-radius: 999px; background: rgba(25,18,16,.68); backdrop-filter: blur(8px); font-size: .78rem; }
    .partner-preview { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; margin-top: 16px; }
    .partner-preview div { display: flex; align-items: center; justify-content: center; min-height: 94px; padding: 18px; border: 1px solid rgba(42,31,31,.09); border-radius: 18px; background: rgba(255,255,255,.44); }
    .partner-preview img { max-width: 100%; max-height: 42px; }
    .home-cta { padding: clamp(64px, 9vw, 120px) 0; }
    .home-cta__box { display: flex; justify-content: space-between; align-items: center; gap: 30px; padding: clamp(30px, 5vw, 68px); border-radius: 30px; background: #2a1f1f; color: #fff; }
    .home-cta p { margin: 14px 0 0; color: rgba(255,255,255,.72); }

    @media (max-width: 900px) {
      .home-hero__grid { grid-template-columns: 1fr; }
      .home-hero__media { min-height: 500px; }
      .date-preview { grid-template-columns: 1fr; }
      .date-preview article { min-height: 0; }
      .photo-preview { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: 210px; }
      .partner-preview { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    @media (max-width: 620px) {
      .home-hero { padding-top: 24px; }
      .home-hero__copy h1 { font-size: clamp(3rem, 15vw, 4.4rem); }
      .home-hero__media { min-height: 410px; border-radius: 24px; }
      .section-intro { display: grid; align-items: start; }
      .section-link { order: 2; }
      .photo-preview { display: flex; width: calc(100vw - 24px); margin-left: calc((100% - (100vw - 24px)) / 2); padding-bottom: 8px; overflow-x: auto; scroll-snap-type: x mandatory; }
      .photo-preview__item, .photo-preview__item--wide { flex: 0 0 82vw; height: 330px; scroll-snap-align: center; }
      .home-cta__box { align-items: flex-start; flex-direction: column; }
    }
  </style>
</BaseLayout>
